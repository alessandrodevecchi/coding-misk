// coding-misk · Groove Room
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(123/4)

const SECTIONS = [['Intro', 16], ['Build', 96], ['Peak', 32], ['Outro', 16]]
const TEMPO = {'Intro': 123, 'Build': 123, 'Peak': 123, 'Outro': 123}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!16 0!144>"  // Intro · 16 bars · 123 BPM · D · Dm C A# C
const section2 = "<0!16 1!96 0!48>"  // Build · 96 bars · 123 BPM · D · Dm C A# C
const section3 = "<0!112 1!32 0!16>"  // Peak · 32 bars · 123 BPM · D · Dm C A# C
const section4 = "<0!144 1!16>"  // Outro · 16 bars · 123 BPM · D · Dm C A# C

// ========== Kick · drums ==========
// Intro · bars 1-16 · pattern A
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).distort(0.21).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("kick")
// Build · bars 17-112 · pattern A
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).distort(0.21).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("kick")
// Peak · bars 113-144 · pattern A
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).distort(0.21).distortvol(.5).mask(section3).velocity(section3).orbit(1).analyze("kick")
// Outro · bars 145-160 · pattern A
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).distort(0.21).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("kick")

// ========== Beat · drums ==========
// Intro · bars 1-16 · pattern A
// Drums · RolandTR909
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.48).distort(0.09).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("snare")
$: s("~ ~ [~ ~ ~ sd] ~").bank("RolandTR909").gain(0.45).distort(0.09).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.3).distort(0.09).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("RolandTR909").gain(0.27).distort(0.09).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("hats")
// Build · bars 17-112 · pattern A
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.48).distort(0.09).distortvol(.5).mask(section2).velocity(section2).orbit(9).analyze("snare")
$: s("~ ~ [~ ~ ~ sd] ~").bank("RolandTR909").gain(0.45).distort(0.09).distortvol(.5).mask(section2).velocity(section2).orbit(9).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.3).distort(0.09).distortvol(.5).mask(section2).velocity(section2).orbit(9).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("RolandTR909").gain(0.27).distort(0.09).distortvol(.5).mask(section2).velocity(section2).orbit(9).analyze("hats")
// Peak · bars 113-144 · pattern A
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.48).distort(0.09).distortvol(.5).mask(section3).velocity(section3).orbit(9).analyze("snare")
$: s("~ ~ [~ ~ ~ sd] ~").bank("RolandTR909").gain(0.45).distort(0.09).distortvol(.5).mask(section3).velocity(section3).orbit(9).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.3).distort(0.09).distortvol(.5).mask(section3).velocity(section3).orbit(9).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("RolandTR909").gain(0.27).distort(0.09).distortvol(.5).mask(section3).velocity(section3).orbit(9).analyze("hats")
// Outro · bars 145-160 · pattern A
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.48).distort(0.09).distortvol(.5).mask(section4).velocity(section4).orbit(9).analyze("snare")
$: s("~ ~ [~ ~ ~ sd] ~").bank("RolandTR909").gain(0.45).distort(0.09).distortvol(.5).mask(section4).velocity(section4).orbit(9).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.3).distort(0.09).distortvol(.5).mask(section4).velocity(section4).orbit(9).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("RolandTR909").gain(0.27).distort(0.09).distortvol(.5).mask(section4).velocity(section4).orbit(9).analyze("hats")

// ========== Bass · bass ==========
// Intro · bars 1-16 · pattern A
// Bass · Walking (quarters)
$: note("<a1 g1 f1 g1>").transpose(5).struct("x x x x")
  .s("square").lpf(sine.range(302, 1206).slow(8)).lpq(7.45)
  .decay(.4).sustain(.3).gain(0.8).mask(section1).velocity(section1).orbit(2).analyze("bass")
// Build · bars 17-112 · pattern A
$: note("<a1 g1 f1 g1>").transpose(5).struct("x x x x")
  .s("square").lpf(sine.range(302, 1206).slow(8)).lpq(7.45)
  .decay(.4).sustain(.3).gain(0.8).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Peak · bars 113-144 · pattern A
$: note("<a1 g1 f1 g1>").transpose(5).struct("x x x x")
  .s("square").lpf(sine.range(302, 1206).slow(8)).lpq(7.45)
  .decay(.4).sustain(.3).gain(0.8).mask(section3).velocity(section3).orbit(2).analyze("bass")
// Outro · bars 145-160 · pattern A
$: note("<a1 g1 f1 g1>").transpose(5).struct("x x x x")
  .s("square").lpf(sine.range(302, 1206).slow(8)).lpq(7.45)
  .decay(.4).sustain(.3).gain(0.8).mask(section4).velocity(section4).orbit(2).analyze("bass")

// ========== Lead · hook ==========
// Intro · bars 1-16 · pattern A
// Hook · Echo
$: n("<[0 ~ ~ 4 ~ ~ 7 ~]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.37).room(.3).gain(0.3).mask(section1).velocity(section1).orbit(4).analyze("hook")
// Build · bars 17-112 · pattern A
$: n("<[0 ~ ~ 4 ~ ~ 7 ~]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.37).room(.3).gain(0.3).mask(section2).velocity(section2).orbit(4).analyze("hook")
// Peak · bars 113-144 · pattern A
$: n("<[0 ~ ~ 4 ~ ~ 7 ~]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.37).room(.3).gain(0.3).mask(section3).velocity(section3).orbit(4).analyze("hook")
// Outro · bars 145-160 · pattern A
$: n("<[0 ~ ~ 4 ~ ~ 7 ~]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.37).room(.3).gain(0.3).mask(section4).velocity(section4).orbit(4).analyze("hook")

// ========== Pad · pad ==========
// Intro · bars 1-16 · pattern A
// Pad · Stab
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section1).velocity(section1).orbit(6).analyze("pad")
// Build · bars 17-112 · pattern A
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section2).velocity(section2).orbit(6).analyze("pad")
// Peak · bars 113-144 · pattern A
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section3).velocity(section3).orbit(6).analyze("pad")
// Outro · bars 145-160 · pattern A
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section4).velocity(section4).orbit(6).analyze("pad")

// ========== Riser · riser ==========
// Intro · bars 1-16 · pattern A
// Riser · white noise rising over 8 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000))
  .gain(saw.slow(8).range(0, .25)).mask(section1).velocity(section1).orbit(8).analyze("riser")
// Build · bars 17-112 · pattern A
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(16))
  .gain(saw.slow(8).range(0, .25).late(16)).mask(section2).velocity(section2).orbit(8).analyze("riser")
// Peak · bars 113-144 · pattern A
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(112))
  .gain(saw.slow(8).range(0, .25).late(112)).mask(section3).velocity(section3).orbit(8).analyze("riser")
// Outro · bars 145-160 · pattern A
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(144))
  .gain(saw.slow(8).range(0, .25).late(144)).mask(section4).velocity(section4).orbit(8).analyze("riser")
