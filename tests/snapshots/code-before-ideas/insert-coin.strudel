// coding-misk · Insert Coin
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(150/4)

const SECTIONS = [['Insert coin', 2], ['Livello 1', 8], ['Livello 1 B', 8], ['Boss', 8], ['Bonus', 4], ['Livello 2', 8], ['Game over', 2]]
const TEMPO = {'Insert coin': 150, 'Livello 1': 150, 'Livello 1 B': 150, 'Boss': 156, 'Bonus': 150, 'Livello 2': 152, 'Game over': 152}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!2 0!38>"  // Insert coin · 2 bars · 150 BPM · A · Am F G Am
const section2 = "<0!2 1!8 0!30>"  // Livello 1 · 8 bars · 150 BPM · A · Am F G Am
const section3 = "<0!10 1!8 0!22>"  // Livello 1 B · 8 bars · 150 BPM · A · Am F G Am
const section4 = "<0!18 1!8 0.5 0!13>"  // Boss · 8 bars · 156 BPM · A · Am Am Am A#
const section5 = "<0!26 0.5 1!3 0!10>"  // Bonus · 4 bars · 150 BPM · A · Am F G Am · fades in over 1 bars
const section6 = "<0!30 1!8 0!2>"  // Livello 2 · 8 bars · 152 BPM · B · Bm G A Bm
const section7 = "<0!38 1!2>"  // Game over · 2 bars · 152 BPM · B · Bm G A Bm

// ========== drums ==========
// Insert coin · bars 1-2 · pattern A
// Drums · YamahaRX5
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("YamahaRX5").gain("<0.2 0.4>").distort(0.4).distortvol(.5).crush(13).mask("<1 [1 0]>").mask(section1).velocity(section1).orbit(1).analyze("hats")
// Livello 1 · bars 3-10 · pattern B
$: s("[bd ~ ~ ~] [~ ~ bd ~] [~ ~ bd ~] ~").bank("YamahaRX5").gain(0.9).distort(0.4).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ sd]").bank("YamahaRX5").gain(0.68).distort(0.4).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("YamahaRX5").gain(0.45).distort(0.4).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!2 1 0!5>").mask(section2).velocity(section2).orbit(1).analyze("fx")
// Livello 1 B · bars 11-18 · pattern C
$: s("[bd ~ ~ ~] [~ ~ bd ~] [~ ~ bd ~] ~").bank("YamahaRX5").gain(0.9).distort(0.4).distortvol(.5).crush(13).mask(section3).velocity(section3).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ sd]").bank("YamahaRX5").gain(0.68).distort(0.4).distortvol(.5).crush(13).mask(section3).velocity(section3).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("YamahaRX5").gain(0.45).distort(0.4).distortvol(.5).crush(13).mask(section3).velocity(section3).orbit(1).analyze("hats")
$: s("~ ~ ~ [~ ~ oh ~]").bank("YamahaRX5").gain(0.41).distort(0.4).distortvol(.5).crush(13).mask(section3).velocity(section3).orbit(1).analyze("hats")
$: s("sd*16").bank("YamahaRX5").gain(saw.range(.15, .75)).mask("<0 1 0!6>").mask(section3).velocity(section3).orbit(1).analyze("snare")
// Boss · bars 19-26 · pattern D
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("YamahaRX5").gain(0.9).distort(1).distortvol(.5).crush(13).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ ~]").bank("YamahaRX5").gain(0.68).distort(1).distortvol(.5).crush(13).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("YamahaRX5").gain(0.45).distort(1).distortvol(.5).crush(13).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("sd*16").bank("YamahaRX5").gain(saw.range(.15, .75)).mask("<0 1 0!6>").mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!2 1 0!5>").mask(section4).velocity(section4).orbit(1).analyze("fx")
// Bonus · bars 27-30 · pattern E
$: s("[bd ~ ~ ~] ~ [~ ~ bd ~] ~").bank("YamahaRX5").gain(0.9).distort(0.4).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("kick")
$: s("~ ~ [sd ~ ~ ~] ~").bank("YamahaRX5").gain(0.68).distort(0.4).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("YamahaRX5").gain(0.45).distort(0.4).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("hats")
// Livello 2 · bars 31-38 · pattern F
$: s("[bd ~ ~ ~] [~ ~ bd ~] [~ ~ bd ~] ~").bank("YamahaRX5").gain(0.9).distort(0.4).distortvol(.5).crush(13).mask(section6).velocity(section6).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ sd]").bank("YamahaRX5").gain(0.68).distort(0.4).distortvol(.5).crush(13).mask(section6).velocity(section6).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("YamahaRX5").gain(0.45).distort(0.4).distortvol(.5).crush(13).mask(section6).velocity(section6).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("YamahaRX5").gain(0.41).distort(0.4).distortvol(.5).crush(13).mask(section6).velocity(section6).orbit(1).analyze("hats")
$: s("sd*16").bank("YamahaRX5").gain(saw.range(.15, .75)).mask("<0!5 1 0!2>").mask(section6).velocity(section6).orbit(1).analyze("snare")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!6 1 0>").mask(section6).velocity(section6).orbit(1).analyze("fx")

// ========== bass ==========
// Livello 1 · bars 3-10 · pattern A
// Bass · Arcade octaves
$: note("<g1 a1 a1 f1>").struct("x x x x x x x x x x x x x x x x").transpose("0 12 0 12 0 12 0 12 0 12 0 12 -2 10 -2 10")
  .s("square").lpf(1800).lpq(2).distort(0.5).distortvol(.5)
  .decay(.1).sustain(.3).gain(0.85).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Livello 1 B · bars 11-18 · pattern A
$: note("<g1 a1 a1 f1>").struct("x x x x x x x x x x x x x x x x").transpose("0 12 0 12 0 12 0 12 0 12 0 12 -2 10 -2 10")
  .s("square").lpf(1800).lpq(2).distort(0.5).distortvol(.5)
  .decay(.1).sustain(.3).gain(0.85).mask(section3).velocity(section3).orbit(2).analyze("bass")
// Boss · bars 19-26 · pattern B
// Bass · Tritone riff
$: note("<a1 a#1 a1 a1>").struct("x ~ ~ x ~ ~ x ~ x ~ x ~ x ~ ~ ~").transpose("0 0 0 0 0 0 0 0 7 0 6 0 0 0 0 0")
  .s("sawtooth").lpf(1600).lpq(6).distort(2).distortvol(.5)
  .decay(.12).sustain(.3).gain(0.55).mask(section4).velocity(section4).orbit(2).analyze("bass")
// Livello 2 · bars 31-38 · pattern A
// Bass · Arcade octaves
$: note("<g1 a1 a1 f1>").transpose(2).struct("x x x x x x x x x x x x x x x x").transpose("0 12 0 12 0 12 0 12 0 12 0 12 -2 10 -2 10")
  .s("square").lpf(1800).lpq(2).distort(0.5).distortvol(.5)
  .decay(.1).sustain(.3).gain(0.9).mask(section6).velocity(section6).orbit(2).analyze("bass")

// ========== arp ==========
// Insert coin · bars 1-2 · pattern A
// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4]>")
  .s("square").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).gain(0.26).mask("<1 [1 0]>").mask(section1).velocity(section1).orbit(3).analyze("arp")
// Livello 1 B · bars 11-18 · pattern A
$: note("<[g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4]>")
  .s("square").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).gain(0.24).mask(section3).velocity(section3).orbit(3).analyze("arp")
// Bonus · bars 27-30 · pattern B
// Arpeggio · Up and down, 16ths
$: note("<[g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3]>")
  .s("square").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).gain(0.26).mask(section5).velocity(section5).orbit(3).analyze("arp")
// Livello 2 · bars 31-38 · pattern A
// Arpeggio · Up, 16ths
$: note("<[g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4]>").transpose(2)
  .s("square").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).gain(0.22).mask(section6).velocity(section6).orbit(3).analyze("arp")

// ========== hook ==========
// Livello 1 · bars 3-10 · pattern A
// Hook · Arcade
$: n("<[8 8 15 8 ~ 8 13 15] [10 ~ 12 ~ 15 ~ 17 ~] [0 0 12 0 ~ 0 10 12] [0 0 12 0 ~ 15 12 10]>").scale("A4:chromatic")
  .s("square").fm(2).lpf(5000).crush(12)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.45).mask(section2).velocity(section2).orbit(4).analyze("hook")
// Livello 1 B · bars 11-18 · pattern B
// Hook · Arcade B
$: n("<[5 ~ 7 8 ~ 10 ~ 12] [15 12 10 7 ~ 12 ~ ~] [12 ~ 10 12 ~ 15 ~ 12] [10 ~ 8 7 ~ 5 ~ 3]>").scale("A4:chromatic")
  .s("square").fm(2).lpf(5000).crush(12)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.45).mask(section3).velocity(section3).orbit(4).analyze("hook")
// Boss · bars 19-26 · pattern C
// Hook · Boss
$: n("<[0 1 0 1 0 ~ 6 ~] [0 1 0 1 3 ~ 1 ~]>").scale("A4:chromatic")
  .s("square").fm(3).lpf(5000).crush(12)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.45).mask(section4).velocity(section4).orbit(4).analyze("hook")
// Livello 2 · bars 31-38 · pattern A
// Hook · Arcade
$: n("<[8 8 15 8 ~ 8 13 15] [10 ~ 12 ~ 15 ~ 17 ~] [0 0 12 0 ~ 0 10 12] [0 0 12 0 ~ 15 12 10]>").scale("B4:chromatic")
  .s("square").fm(2).lpf(5000).crush(12)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.48).mask(section6).velocity(section6).orbit(4).analyze("hook")
// Game over · bars 39-40 · pattern D
// Hook · Hits
$: n("<[0 ~ ~ 0 ~ ~ 12 ~] [~ ~ 0 ~ 1 ~ ~ ~]>").scale("B4:chromatic")
  .s("square").fm(2).lpf(5000).crush(12)
  .decay(.2).sustain(.3).delay(.5).room(.3).gain("<0.26 0>").mask(section7).velocity(section7).orbit(4).analyze("hook")

// ========== pad ==========
// Game over · bars 39-40 · pattern A
// Pad · Sustained
$: note("<[g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [f2,a2,c3]>").transpose(2)
  .s("square").attack(.4).release(1.2).lpf("<2500 600>")
  .room(.6).gain("<0.2 0>").mask(section7).velocity(section7).orbit(6).analyze("pad")
