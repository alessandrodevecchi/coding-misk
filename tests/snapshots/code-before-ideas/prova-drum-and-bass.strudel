// coding-misk · Drum and bass
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(172/4)

const SECTIONS = [['A', 32], ['B', 96]]
const TEMPO = {'A': 172, 'B': 172}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!32 0!96>"  // A · 32 bars · 172 BPM · E · Em Em D D
const section2 = "<0!32 1!96>"  // B · 96 bars · 172 BPM · E · Em Em D D

// ========== Kick · drums ==========
// A · bars 1-32 · pattern A
// Drums · AkaiXR10
$: s("[bd ~ ~ ~] ~ [~ ~ bd ~] ~").bank("AkaiXR10").gain(0.85).distort(0.1).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ ~]").bank("AkaiXR10").gain(0.64).distort(0.1).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh hh]").bank("AkaiXR10").gain(0.43).distort(0.1).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("hats")
// B · bars 33-128 · pattern A
$: s("[bd ~ ~ ~] ~ [~ ~ bd ~] ~").bank("AkaiXR10").gain(0.85).distort(0.1).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ ~]").bank("AkaiXR10").gain(0.64).distort(0.1).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh hh]").bank("AkaiXR10").gain(0.43).distort(0.1).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("hats")

// ========== Bass · bass ==========
// A · bars 1-32 · pattern A
// Bass · Rolling
$: note("<a1 a1 g1 g1>").transpose(-5).struct("[~ x x x] [~ x x x] [~ x x x] [~ x x x]")
  .s("supersaw").lpf(sine.range(328, 1312).slow(8)).lpq(12.66)
  .decay(.12).sustain(0).gain(0.8).mask(section1).velocity(section1).orbit(2).analyze("bass")
// B · bars 33-128 · pattern A
$: note("<a1 a1 g1 g1>").transpose(-5).struct("[~ x x x] [~ x x x] [~ x x x] [~ x x x]")
  .s("supersaw").lpf(sine.range(328, 1312).slow(8)).lpq(12.66)
  .decay(.12).sustain(0).gain(0.8).mask(section2).velocity(section2).orbit(2).analyze("bass")

// ========== Pad · pad ==========
// A · bars 1-32 · pattern A
// Pad · Stab
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section1).velocity(section1).orbit(6).analyze("pad")
// B · bars 33-128 · pattern A
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-5).struct("x ~ ~ x ~ ~ x ~ ~ ~ x ~ x ~ ~ ~")
  .s("gm_epiano1").attack(.01).decay(.15).sustain(0).release(.1).lpf(sine.range(926, 3706).slow(8))
  .room(.85).gain(0.28).mask(section2).velocity(section2).orbit(6).analyze("pad")

// ========== Arp · arp ==========
// B · bars 33-128 · pattern A
// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>").transpose(-5)
  .s("supersaw").lpf(sine.range(1081, 4323).slow(8)).lpq(4)
  .decay(.15).sustain(.15).delay(.62).gain(0.4).mask(section2).velocity(section2).orbit(3).analyze("arp")
