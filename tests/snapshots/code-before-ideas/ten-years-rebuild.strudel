// coding-misk · Ten Years · ricostruzione
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(92/4)

const SECTIONS = [['Intro', 8], ['Strofa A', 9], ['Swoosh', 1], ['Strofa B', 8], ['Breakdown', 6], ['Riser', 2], ['Finale', 20], ['Outro', 3]]
const TEMPO = {'Intro': 92, 'Strofa A': 92, 'Swoosh': 92, 'Strofa B': 92, 'Breakdown': 92, 'Riser': 92, 'Finale': 92, 'Outro': 92}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!8 0!49>"  // Intro · 8 bars · 92 BPM · E · Em Em D D
const section2 = "<0!8 1!9 0!40>"  // Strofa A · 9 bars · 92 BPM · E · Em Em D D C C D D
const section3 = "<0!17 1 0!39>"  // Swoosh · 1 bars · 92 BPM · E · Em Em D D C C D D
const section4 = "<0!18 1!8 0.67 0.33 0!29>"  // Strofa B · 8 bars · 92 BPM · E · Em Em D D C C D D
const section5 = "<0!26 0.33 0.67 1!4 0!25>"  // Breakdown · 6 bars · 92 BPM · E · Em Em D D · fades in over 2 bars
const section6 = "<0!32 1!2 0!23>"  // Riser · 2 bars · 92 BPM · E · Em Em D D
const section7 = "<0!34 1!20 0!3>"  // Finale · 20 bars · 92 BPM · E · Em Em D D C C D D
const section8 = "<0!54 1!3>"  // Outro · 3 bars · 92 BPM · E · Em Em D D

// ========== drums ==========
// Strofa A · bars 9-17 · pattern A
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.43).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0!7 1 0>").mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!8 1>").mask(section2).velocity(section2).orbit(1).analyze("fx")
// Strofa B · bars 19-26 · pattern A
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.43).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!2 1 0!5>").mask(section4).velocity(section4).orbit(1).analyze("fx")
// Riser · bars 33-34 · pattern B
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.43).mask("<1 [1 0]>").mask(section6).velocity(section6).orbit(1).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0 1>").mask(section6).velocity(section6).orbit(1).analyze("snare")
// Finale · bars 35-54 · pattern C
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(section7).velocity(section7).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask(section7).velocity(section7).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.43).mask(section7).velocity(section7).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.38).mask(section7).velocity(section7).orbit(1).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0!13 1 0!6>").mask(section7).velocity(section7).orbit(1).analyze("snare")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!14 1 0!5>").mask(section7).velocity(section7).orbit(1).analyze("fx")

// ========== bass ==========
// Intro · bars 1-8 · pattern A
// Bass · Long sub
$: note("<a1 a1 g1 g1>").transpose(-5).struct("x")
  .s("sine").lpf(400).lpq(2)
  .decay(.6).sustain(.8).gain(0.35).mask(section1).velocity(section1).orbit(2).analyze("bass")
// Strofa A · bars 9-17 · pattern B
// Bass · Pumping (sidechain)
$: note("<a1 a1 g1 g1 f1 f1 g1 g1>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.7).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Strofa B · bars 19-26 · pattern B
$: note("<g1 g1 a1 a1 g1 g1 f1 f1>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.7).mask(section4).velocity(section4).orbit(2).analyze("bass")
// Breakdown · bars 27-32 · pattern A
// Bass · Long sub
$: note("<g1 g1 a1 a1>").transpose(-5).struct("x")
  .s("sine").lpf(400).lpq(2)
  .decay(.6).sustain(.8).gain(0.4).mask(section5).velocity(section5).orbit(2).analyze("bass")
// Finale · bars 35-54 · pattern B
// Bass · Pumping (sidechain)
$: note("<g1 g1 a1 a1 g1 g1 f1 f1>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.8).mask(section7).velocity(section7).orbit(2).analyze("bass")

// ========== arp ==========
// Intro · bars 1-8 · pattern A
// Arpeggio · Up and down, 16ths
$: note("<[a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3]>").transpose(-5)
  .s("triangle").lpf("<1200 1400 1600 1800 2000 2200 2400 2600>").lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain("<0.15 0.17 0.19 0.21 0.22 0.24 0.26 0.28>").mask(section1).velocity(section1).orbit(3).analyze("arp")
// Strofa A · bars 9-17 · pattern A
$: note("<[a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3]>").transpose(-5)
  .s("triangle").lpf(2600).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.28).mask(section2).velocity(section2).orbit(3).analyze("arp")
// Strofa B · bars 19-26 · pattern A
$: note("<[g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3]>").transpose(-5)
  .s("triangle").lpf(2600).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.28).mask(section4).velocity(section4).orbit(3).analyze("arp")
// Breakdown · bars 27-32 · pattern A
$: note("<[g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4]>").transpose(-5)
  .s("triangle").lpf(900).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.2).mask(section5).velocity(section5).orbit(3).analyze("arp")
// Riser · bars 33-34 · pattern A
$: note("<[a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3]>").transpose(-5)
  .s("triangle").lpf("<1400 2600>").lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.22).mask("<1 [1 0]>").mask(section6).velocity(section6).orbit(3).analyze("arp")
// Finale · bars 35-54 · pattern A
$: note("<[g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3]>").transpose(-5)
  .s("triangle").lpf(3000).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.3).mask(section7).velocity(section7).orbit(3).analyze("arp")

// ========== hook ==========
// Strofa B · bars 19-26 · pattern A
// Hook · Decade
$: n("<[1 1 1 ~ 1 2 1 -1] [-1 ~ ~ ~ 1 ~ 2 ~] [0 0 0 1 2 0 2 0] [0 0 4 1 0 0 2 0] [2 -1 -1 ~ -1 1 2 1] [-1 ~ -1 ~ -1 -1 2 2] [4 ~ 4 3 2 ~ 1 0] [2 ~ 2 1 0 ~ -1 0]>").scale("E4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.3).room(.3).gain(0.24).mask(section4).velocity(section4).orbit(4).analyze("hook")
// Finale · bars 35-54 · pattern A
$: n("<[1 1 1 ~ 1 2 1 -1] [-1 ~ ~ ~ 1 ~ 2 ~] [0 0 0 1 2 0 2 0] [0 0 4 1 0 0 2 0] [2 -1 -1 ~ -1 1 2 1] [-1 ~ -1 ~ -1 -1 2 2] [4 ~ 4 3 2 ~ 1 0] [2 ~ 2 1 0 ~ -1 0]>").scale("E4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.3).room(.3).gain(0.28).mask(section7).velocity(section7).orbit(4).analyze("hook")

// ========== pad ==========
// Intro · bars 1-8 · pattern A
// Pad · Sustained
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf("<600 828.57 1057.14 1285.71 1514.29 1742.86 1971.43 2200>")
  .room(.9).gain("<0.2 0.22 0.23 0.25 0.27 0.29 0.3 0.32>").mask(section1).velocity(section1).orbit(6).analyze("pad")
// Strofa A · bars 9-17 · pattern B
// Pad · Sidechain
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3] [f2,a2,c3] [f2,a2,c3] [g2,b2,d3] [g2,b2,d3]>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf(2400)
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.3).mask(section2).velocity(section2).orbit(6).analyze("pad")
// Swoosh · bars 18-18 · pattern A
// Pad · Sustained
$: note("<[g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3] [f2,a2,c3] [f2,a2,c3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf(1200)
  .room(.9).gain(0.2).mask(section3).velocity(section3).orbit(6).analyze("pad")
// Strofa B · bars 19-26 · pattern B
// Pad · Sidechain
$: note("<[g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3] [f2,a2,c3] [f2,a2,c3]>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf(2600)
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.3).mask(section4).velocity(section4).orbit(6).analyze("pad")
// Breakdown · bars 27-32 · pattern A
// Pad · Sustained
$: note("<[g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf("<1460 1600 900 1040 1180 1320>")
  .room(.9).gain(0.3).mask(section5).velocity(section5).orbit(6).analyze("pad")
// Riser · bars 33-34 · pattern A
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf("<1600 3000>")
  .room(.9).gain(0.3).mask(section6).velocity(section6).orbit(6).analyze("pad")
// Finale · bars 35-54 · pattern B
// Pad · Sidechain
$: note("<[g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3] [f2,a2,c3] [f2,a2,c3]>").transpose(-5).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf(3200)
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.34).mask(section7).velocity(section7).orbit(6).analyze("pad")
// Outro · bars 55-57 · pattern A
// Pad · Sustained
$: note("<[g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf("<2000 1300 600>")
  .room(.9).gain("<0.3 0.15 0>").mask(section8).velocity(section8).orbit(6).analyze("pad")

// ========== riser ==========
// Swoosh · bars 18-18 · pattern A
// Downlifter · noise falling over 2 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(2).range(8000, 300).late(17))
  .gain(saw.slow(2).range(.35, 0).late(17)).mask(section3).velocity(section3).orbit(8).analyze("riser")
// Riser · bars 33-34 · pattern A
// Riser · white noise rising over 2 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(2).range(300, 8000).late(32))
  .gain(saw.slow(2).range(0, .4).late(32)).mask(section6).velocity(section6).orbit(8).analyze("riser")
// Outro · bars 55-57 · pattern A
// Downlifter · noise falling over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(8000, 300).late(54))
  .gain(saw.slow(4).range(.3, 0).late(54)).mask(section8).velocity(section8).orbit(8).analyze("riser")
