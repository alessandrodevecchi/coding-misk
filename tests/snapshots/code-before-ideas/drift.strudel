// coding-misk · Drift
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(128/4)

const SECTIONS = [['Intro', 4], ['Drop', 16], ['Break', 4], ['Drop 2', 16], ['Outro', 3], ['Colpo', 1]]
const TEMPO = {'Intro': 128, 'Drop': 128, 'Break': 128, 'Drop 2': 128, 'Outro': 128, 'Colpo': 128}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!4 0!40>"  // Intro · 4 bars · 128 BPM · F# · F#m F#m E E
const section2 = "<0!4 1!16 0.5 0!23>"  // Drop · 16 bars · 128 BPM · F# · F#m F#m E E
const section3 = "<0!20 0.5 1!3 0!20>"  // Break · 4 bars · 128 BPM · F# · F#m F#m E E · fades in over 1 bars
const section4 = "<0!24 1!16 0!4>"  // Drop 2 · 16 bars · 128 BPM · F# · F#m F#m E E
const section5 = "<0!40 1!3 0>"  // Outro · 3 bars · 128 BPM · F# · F#m F#m E E
const section6 = "<0!43 1>"  // Colpo · 1 bars · 128 BPM · F# · F#m F#m E E

// ========== drums ==========
// Drop · bars 5-20 · pattern A
// Drums · RolandTR808
$: s("[bd ~ ~ ~] [~ ~ ~ bd] [~ ~ bd ~] ~").bank("RolandTR808").gain(0.95).distort(1.5).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR808").gain(0.76).distort(1.5).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR808").gain(0.48).distort(1.5).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("~ [~ ~ oh ~] ~ [~ ~ oh ~]").bank("RolandTR808").gain(0.43).distort(1.5).distortvol(.5).crush(13).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR808").gain(.55).room(.4).mask("<0!4 1 0!11>").mask(section2).velocity(section2).orbit(1).analyze("fx")
// Break · bars 21-24 · pattern B
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR808").gain(0.48).lpf("<600 7066.67 13533.33 20000>").distort(1.5).distortvol(.5).crush(13).mask("<1!3 [1 0]>").mask(section3).velocity(section3).orbit(1).analyze("hats")
$: s("sd*16").bank("RolandTR808").gain(saw.range(.15, .75)).mask("<0!3 1>").mask(section3).velocity(section3).orbit(1).analyze("snare")
// Drop 2 · bars 25-40 · pattern C
$: s("[bd ~ ~ ~] [~ ~ ~ bd] [~ ~ bd ~] ~").bank("RolandTR808").gain(0.95).distort(2.5).distortvol(.5).crush(11).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR808").gain(0.76).distort(2.5).distortvol(.5).crush(11).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR808").gain(0.48).distort(2.5).distortvol(.5).crush(11).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR808").gain(0.43).distort(2.5).distortvol(.5).crush(11).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR808").gain(.55).room(.4).mask("<0!8 1 0!7>").mask(section4).velocity(section4).orbit(1).analyze("fx")
// Outro · bars 41-43 · pattern A
$: s("[bd ~ ~ ~] [~ ~ ~ bd] [~ ~ bd ~] ~").bank("RolandTR808").gain("<0.2 0.95 0.57>").distort(1.5).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR808").gain("<0.16 0.76 0.46>").distort(1.5).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR808").gain("<0.1 0.48 0.29>").distort(1.5).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("hats")
$: s("~ [~ ~ oh ~] ~ [~ ~ oh ~]").bank("RolandTR808").gain("<0.09 0.43 0.26>").distort(1.5).distortvol(.5).crush(13).mask(section5).velocity(section5).orbit(1).analyze("hats")

// ========== bass ==========
// Drop · bars 5-20 · pattern A
// Bass · Long sub
$: note("<a1 a1 g1 g1>").transpose(-3).struct("x")
  .s("sine").lpf(900).lpq(2).distort(4).distortvol(.5)
  .decay(.6).sustain(.8).gain(0.8).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Drop 2 · bars 25-40 · pattern A
$: note("<a1 a1 g1 g1>").transpose(-3).struct("x")
  .s("sine").lpf(900).lpq(2).distort(6).distortvol(.5)
  .decay(.6).sustain(.8).gain(0.85).mask(section4).velocity(section4).orbit(2).analyze("bass")
// Colpo · bars 44-44 · pattern A
$: note("<a1 g1 g1 a1>").transpose(-3).struct("x")
  .s("sine").lpf(900).lpq(2).distort(5).distortvol(.5)
  .decay(.6).sustain(.8).gain(0.8).mask(section6).velocity(section6).orbit(2).analyze("bass")

// ========== hook ==========
// Intro · bars 1-4 · pattern A
// Hook · Phonk
$: n("<[0 ~ 0 ~ 3 ~ 2 ~] [0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(1).distortvol(.5).lpf("<1200 2800 4400 6000>")
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.4).mask(section1).velocity(section1).orbit(4).analyze("hook")
// Drop · bars 5-20 · pattern A
$: n("<[0 ~ 0 ~ 3 ~ 2 ~] [0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(1).distortvol(.5).lpf(6000)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.45).mask(section2).velocity(section2).orbit(4).analyze("hook")
// Break · bars 21-24 · pattern A
$: n("<[0 ~ 0 ~ 3 ~ 2 ~] [0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(1).distortvol(.5).lpf(2000)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.4).mask("<1!3 [1 0]>").mask(section3).velocity(section3).orbit(4).analyze("hook")
// Drop 2 · bars 25-40 · pattern A
$: n("<[0 ~ 0 ~ 3 ~ 2 ~] [0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(2).distortvol(.5).lpf(6000)
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.5).mask(section4).velocity(section4).orbit(4).analyze("hook")
// Outro · bars 41-43 · pattern A
$: n("<[0 ~ 0 ~ 3 ~ 2 ~] [0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(1).distortvol(.5).lpf("<1200 6000 3600>")
  .decay(.2).sustain(.3).delay(.15).room(.3).gain(0.4).mask(section5).velocity(section5).orbit(4).analyze("hook")
// Colpo · bars 44-44 · pattern A
$: n("<[0 ~ 0 ~ 5 ~ 4 3] [0 ~ 0 ~ 3 ~ 2 ~] [7 ~ 5 ~ 4 ~ 3 ~] [0 ~ 0 ~ 3 ~ 2 ~]>").scale("F#4:minor")
  .s("cb").bank("RolandTR808").distort(1).distortvol(.5).lpf(6000)
  .decay(.2).sustain(.3).delay(.5).room(.3).gain(0.4).mask(section6).velocity(section6).orbit(4).analyze("hook")

// ========== pad ==========
// Drop · bars 5-20 · pattern A
// Pad · Sustained
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-3)
  .s("gm_choir_aahs").attack(.4).release(1.2).lpf(2000)
  .room(.7).gain(0.16).mask(section2).velocity(section2).orbit(6).analyze("pad")
// Drop 2 · bars 25-40 · pattern A
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(-3)
  .s("gm_choir_aahs").attack(.4).release(1.2).lpf(2500)
  .room(.7).gain(0.2).mask(section4).velocity(section4).orbit(6).analyze("pad")

// ========== texture ==========
// Intro · bars 1-4 · pattern A
// Texture · numbers
$: s("numbers").n("<0 3 7 1>").crush(4).hpf(400).room(.6)
  .gain(0.45).mask(section1).velocity(section1).orbit(7).analyze("fx")
// Drop · bars 5-20 · pattern A
// Texture · vinyl
$: s("white*32").degradeBy(.9).decay(.006).sustain(0).hpf(1800).pan(rand)
  .gain(0.2).mask(section2).velocity(section2).orbit(7).analyze("fx")
// Break · bars 21-24 · pattern B
// Texture · numbers
$: s("numbers*16").n(irand(16)).crush(4).hpf(400).room(.3).pan(rand)
  .gain(0.22).mask(section3).velocity(section3).orbit(7).analyze("fx")
// Drop 2 · bars 25-40 · pattern A
// Texture · vinyl
$: s("white*32").degradeBy(.9).decay(.006).sustain(0).hpf(1800).pan(rand)
  .gain(0.2).mask(section4).velocity(section4).orbit(7).analyze("fx")
// Outro · bars 41-43 · pattern A
$: s("white*32").degradeBy(.9).decay(.006).sustain(0).hpf(1800).pan(rand)
  .gain(0.25).mask(section5).velocity(section5).orbit(7).analyze("fx")

// ========== riser ==========
// Break · bars 21-24 · pattern A
// Riser · white noise rising over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000).late(20))
  .gain(saw.slow(4).range(0, .35).late(20)).mask(section3).velocity(section3).orbit(8).analyze("riser")
