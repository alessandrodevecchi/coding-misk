// ---------- 9 · Fine · 1 bars · 160 BPM · E · Em F Em D ----------
const scene9 = "<0!54 1>"

// Bass · Long sub
$: note("<a1 g1 a1 a#1>").transpose(-5).struct("x")
  .s("gm_electric_bass_pick").lpf(1500).lpq(1).distort(2).distortvol(.5)
  .decay(.6).sustain(.8).gain(0.7).mask(scene9).velocity(scene9).orbit(2).analyze("bass")

// Guitar · Metal hi-gain, Held · tuning -2
$: note("<[a2,e3,a3] [g2,d3,g3] [a2,e3,a3] [a#2,f3,a#3]>").transpose(-7)
