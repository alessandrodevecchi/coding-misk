// coding-misk · Filo di luce
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(124/4)

const SECTIONS = [['Intro', 8], ['Groove', 16], ['Break', 8], ['Drop', 16]]
const TEMPO = {'Intro': 124, 'Groove': 124, 'Break': 124, 'Drop': 124}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!8 0!40>"  // Intro · 8 bars · 124 BPM · D · Dm C A# C
const section2 = "<0!8 1!16 0!24>"  // Groove · 16 bars · 124 BPM · D · Dm C A# C
const section3 = "<0!24 1!8 0!16>"  // Break · 8 bars · 124 BPM · D · Dm C A# C
const section4 = "<0!32 1!16>"  // Drop · 16 bars · 124 BPM · D · Dm C A# C

// ========== drums ==========
// Intro · bars 1-8 · pattern house
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.8).mask(section1).velocity(section1).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.64).mask(section1).velocity(section1).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.4).mask(section1).velocity(section1).orbit(1).analyze("hats")
$: s("[rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~]").bank("RolandTR909").gain(0.28).mask(section1).velocity(section1).orbit(1).analyze("hats")
// Groove · bars 9-24 · pattern house
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.8).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.64).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.4).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("[rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~]").bank("RolandTR909").gain(0.28).mask(section2).velocity(section2).orbit(1).analyze("hats")
// Drop · bars 33-48 · pattern house
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.8).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.64).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.4).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("[rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~] [rd ~ rd ~]").bank("RolandTR909").gain(0.28).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<1 0!15>").mask(section4).velocity(section4).orbit(1).analyze("fx")

// ========== bass ==========
// Groove · bars 9-24 · pattern walk
// Bass · Offbeat
$: note("<a1 g1 f1 g1>").transpose(5).struct("[~ x] [~ x] [~ x] [~ x]")
  .s("square").lpf(sine.range(260, 1040).slow(8)).lpq(6).distort(0.5).distortvol(.5)
  .decay(.18).sustain(0).gain(0.7).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Drop · bars 33-48 · pattern walk
$: note("<a1 g1 f1 g1>").transpose(5).struct("[~ x] [~ x] [~ x] [~ x]")
  .s("square").lpf(sine.range(260, 1040).slow(8)).lpq(6).distort(0.5).distortvol(.5)
  .decay(.18).sustain(0).gain(0.7).mask(section4).velocity(section4).orbit(2).analyze("bass")

// ========== pad ==========
// Intro · bars 1-8 · pattern wash
// Pad · Sustained
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5)
  .s("gm_synth_strings_1").attack(.4).release(1.2).lpf(sine.range(800, 3200).slow(8))
  .room(.85).gain(0.3).mask(section1).velocity(section1).orbit(6).analyze("pad")
// Groove · bars 9-24 · pattern wash
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5)
  .s("gm_synth_strings_1").attack(.4).release(1.2).lpf(sine.range(800, 3200).slow(8))
  .room(.85).gain(0.3).mask(section2).velocity(section2).orbit(6).analyze("pad")
// Break · bars 25-32 · pattern wash
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5)
  .s("gm_synth_strings_1").attack(.4).release(1.2).lpf(sine.range(800, 3200).slow(8))
  .room(.85).gain(0.3).mask(section3).velocity(section3).orbit(6).analyze("pad")
// Drop · bars 33-48 · pattern wash
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g2,b2,d3]>").transpose(5)
  .s("gm_synth_strings_1").attack(.4).release(1.2).lpf(sine.range(800, 3200).slow(8))
  .room(.85).gain(0.3).mask(section4).velocity(section4).orbit(6).analyze("pad")

// ========== arp ==========
// Groove · bars 9-24 · pattern climb
// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>").transpose(5)
  .s("triangle").lpf(sine.range(1040, 4160).slow(8)).lpq(3)
  .decay(.15).sustain(.15).delay(.4).gain(0.35).mask(section2).velocity(section2).orbit(3).analyze("arp")
// Drop · bars 33-48 · pattern climb
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>").transpose(5)
  .s("triangle").lpf(sine.range(1040, 4160).slow(8)).lpq(3)
  .decay(.15).sustain(.15).delay(.4).gain(0.35).mask(section4).velocity(section4).orbit(3).analyze("arp")

// ========== hook ==========
// Break · bars 25-32 · pattern call
// Hook · Call
$: n("<[0 ~ 0 2 ~ 4 ~ 2]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.28).mask("<1!7 [1 0]>").mask(section3).velocity(section3).orbit(4).analyze("hook")
// Drop · bars 33-48 · pattern call
$: n("<[0 ~ 0 2 ~ 4 ~ 2]>").scale("D4:minor")
  .s("square").lpf(3000)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.28).mask(section4).velocity(section4).orbit(4).analyze("hook")
