// coding-misk · Circuito Ruggine
// track composed with the arranger: each scene is a block of layers switched on by its lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(132/4)

const SECTIONS = [['Avvio', 4], ['Macchina', 8], ['Riff', 8], ['Corridoio', 4], ['Drop', 16], ['Blackout', 4], ['Drop 2', 12], ['Spegnimento', 4]]
const TEMPO = {'Avvio': 132, 'Macchina': 132, 'Riff': 132, 'Corridoio': 132, 'Drop': 132, 'Blackout': 132, 'Drop 2': 132, 'Spegnimento': 132}

// ---------- 1 · Avvio · 4 bars · 132 BPM · E · Em C D B ----------
const scene1 = "<1!4 0!56>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.95).lpf("<300 1033.33 1766.67 2500>").distort(1.4).distortvol(.5).crush(13).mask("<1!3 [1 0]>").mask(scene1).velocity(scene1).analyze("kick")

// Guitar · Metal hi-gain, Held · tuning -2
$: note("<[a2,e3,a3] [f2,c3,f3] [g2,d3,g3] [e2,b2,e3]>").transpose(-7)
  .s("gm_distortion_guitar,sawtooth").attack(.003).decay(1.5).sustain(0.8).release(.08)
  .distort(8).distortvol(.2).hpf(110).lpf("<900 1600 2300 3000>").jux(x => x.late(.012))
  .room(.6).gain(.8).mask("<1!3 [1 0]>").mask(scene1).postgain(scene1.mul(0.35)).analyze("guitar")

// Texture · numbers
$: s("numbers").n("<0 3 7 1>").crush(4).hpf(400).room(.7)
  .gain(0.5).mask(scene1).velocity(scene1).analyze("fx")

// Riser · white noise rising over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000))
  .gain(saw.slow(4).range(0, .3)).mask(scene1).velocity(scene1).analyze("riser")

// ---------- 2 · Macchina · 8 bars · 132 BPM · E · Em C D B ----------
const scene2 = "<0!4 1!8 0!48>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.95).distort(1.4).distortvol(.5).crush(13).mask(scene2).velocity(scene2).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.76).distort(1.4).distortvol(.5).crush(13).mask(scene2).velocity(scene2).analyze("snare")
$: s("~ ~ [~ ~ ~ sd] ~").bank("RolandTR909").gain(0.71).distort(1.4).distortvol(.5).crush(13).mask(scene2).velocity(scene2).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.48).distort(1.4).distortvol(.5).crush(13).mask(scene2).velocity(scene2).analyze("hats")
$: s("[~ ~ oh ~] ~ [~ ~ oh ~] ~").bank("RolandTR909").gain(0.43).distort(1.4).distortvol(.5).crush(13).mask(scene2).velocity(scene2).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!4 1 0!3>").mask(scene2).velocity(scene2).analyze("fx")

// Bass · Rumble
$: note("<a1 f1 g1 e1>").transpose(-5).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf(450).lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain(0.55).mask(scene2).velocity(scene2).analyze("bass")

// Arpeggio · Acid, 8ths
$: note("<[a3 a3 [a4 a3] c4 a3 e4 [a3 a4] c4] [f3 f3 [f4 f3] a3 f3 c4 [f3 f4] a3] [g3 g3 [g4 g3] b3 g3 d4 [g3 g4] b3] [g#3 g#3 [g#4 g#3] b3 g#3 e4 [g#3 g#4] b3]>").transpose(-5)
  .s("sawtooth").lpf("<1671.43 1914.29 2157.14 2400 700 942.86 1185.71 1428.57>").lpq(22).distort(1.6).distortvol(.5)
  .decay(.15).sustain(.15).gain(0.32).mask(scene2).velocity(scene2).analyze("arp")

// Texture · metal
$: s("metal(3,8,2)").n("<0 2 4 6>").crush(7).hpf(400).room(.25)
  .gain(0.3).mask(scene2).velocity(scene2).analyze("fx")

// ---------- 3 · Riff · 8 bars · 132 BPM · E · Em C D B ----------
