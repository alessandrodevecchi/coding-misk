const scene4 = "<0!20 1!4 0!36>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain("<0.7 0.78 0.87 0.95>").distort(1.4).distortvol(.5).crush(13).mask("<1!3 [1 0]>").mask(scene4).velocity(scene4).analyze("kick")
