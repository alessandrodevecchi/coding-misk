// Texture · metal
$: s("metal(3,8,2)").n("<0 2 4 6>").crush(7).hpf(400).room(.25)
  .gain(0.3).mask(section7).velocity(section7).orbit(7).analyze("fx")
// Spegnimento · bars 57-60 · pattern A
// Texture · numbers
$: s("numbers").n("<0 3 7 1>").crush(4).hpf(400).room(.9)
  .gain(0.5).mask(section8).velocity(section8).orbit(7).analyze("fx")

// ========== riser ==========
// Avvio · bars 1-4 · pattern A
// Riser · white noise rising over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000))
  .gain(saw.slow(4).range(0, .3)).mask(section1).velocity(section1).orbit(8).analyze("riser")
// Corridoio · bars 21-24 · pattern A
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000).late(20))
  .gain(saw.slow(4).range(0, .4).late(20)).mask(section4).velocity(section4).orbit(8).analyze("riser")
// Blackout · bars 41-44 · pattern A
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000).late(40))
  .gain(saw.slow(4).range(0, .42).late(40)).mask(section6).velocity(section6).orbit(8).analyze("riser")
