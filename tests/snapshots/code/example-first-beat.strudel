// coding-misk · Example 1 · First beat
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(124/4)

const SECTIONS = [['Loop', 8]]
const TEMPO = {'Loop': 124}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!8>"  // Loop · 8 bars · 124 BPM · A · Am

// ========== drums ==========
// Loop · bars 1-8 · pattern A
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.6).mask(section1).velocity(section1).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.48).mask(section1).velocity(section1).orbit(1).analyze("snare")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.3).mask(section1).velocity(section1).orbit(1).analyze("hats")
