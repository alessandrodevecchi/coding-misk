// coding-misk · Acido lento
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(135/4)

const SECTIONS = [['Intro', 16], ['Wave', 16], ['Trough', 16], ['Wave 2', 16], ['Trough 2', 16], ['Wave 3', 16], ['Trough 3', 16], ['Wave 4', 16], ['Trough 4', 16], ['Outro', 16]]
const TEMPO = {'Intro': 135, 'Wave': 135, 'Trough': 135, 'Wave 2': 135, 'Trough 2': 135, 'Wave 3': 135, 'Trough 3': 135, 'Wave 4': 135, 'Trough 4': 135, 'Outro': 135}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!16 0!144>"  // Intro · 16 bars · 135 BPM · E · Em Em Em F
const section2 = "<0!16 1!16 0!128>"  // Wave · 16 bars · 135 BPM · E · Em Em Em F
const section3 = "<0!32 1!16 0!112>"  // Trough · 16 bars · 135 BPM · E · Em Em Em F
const section4 = "<0!48 1!16 0!96>"  // Wave 2 · 16 bars · 135 BPM · E · Em Em Em F
const section5 = "<0!64 1!16 0!80>"  // Trough 2 · 16 bars · 135 BPM · E · Em Em Em F
const section6 = "<0!80 1!16 0!64>"  // Wave 3 · 16 bars · 135 BPM · E · Em Em Em F
const section7 = "<0!96 1!16 0!48>"  // Trough 3 · 16 bars · 135 BPM · E · Em Em Em F
const section8 = "<0!112 1!16 0!32>"  // Wave 4 · 16 bars · 135 BPM · E · Em Em Em F
const section9 = "<0!128 1!16 0!16>"  // Trough 4 · 16 bars · 135 BPM · E · Em Em Em F
const section10 = "<0!144 1!16>"  // Outro · 16 bars · 135 BPM · E · Em Em Em F

// ========== Kick · drums ==========
// Intro · bars 1-16 · pattern A
// Drums · RolandTR909
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("kick")
// Wave · bars 17-32 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("kick")
// Trough · bars 33-48 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section3).velocity(section3).orbit(1).analyze("kick")
// Wave 2 · bars 49-64 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("kick")
// Trough 2 · bars 65-80 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section5).velocity(section5).orbit(1).analyze("kick")
// Wave 3 · bars 81-96 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section6).velocity(section6).orbit(1).analyze("kick")
// Trough 3 · bars 97-112 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section7).velocity(section7).orbit(1).analyze("kick")
// Wave 4 · bars 113-128 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section8).velocity(section8).orbit(1).analyze("kick")
// Trough 4 · bars 129-144 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section9).velocity(section9).orbit(1).analyze("kick")
// Outro · bars 145-160 · pattern A
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(1.42).distortvol(.5).mask(section10).velocity(section10).orbit(1).analyze("kick")

// ========== Beat · drums ==========
// Intro · bars 1-16 · pattern A
// Drums · RolandTR909
$: s("[~ cp]*2").bank("RolandTR909").gain(0.48).distort(1.59).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("snare")
$: s("~!11 sd ~!4").bank("RolandTR909").gain(0.45).distort(1.59).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("snare")
$: s("[~ hh]*4").bank("RolandTR909").gain(0.3).distort(1.59).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("hats")
$: s("[~ oh ~ ~]*2").bank("RolandTR909").gain(0.27).distort(1.59).distortvol(.5).mask(section1).velocity(section1).orbit(9).analyze("hats")
