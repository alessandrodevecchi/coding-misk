// ========== Arp · arp ==========
// Intro · bars 1-16 · pattern A
// Arpeggio · Acid, 16ths
$: note("<[[a3 a3 [a4 a3] c4 a3 e4 [a3 a4] c4]*2]!3 [a#3 a#3 [a#4 a#3] d4 a#3 f4 [a#3 a#4] d4]*2>").transpose(-5)
  .s("sawtooth").lpf(sine.range(378, 1512).slow(8)).lpq(18.62).distort(2.43).distortvol(.5)
  .decay(.15).sustain(.15).delay(.35).gain(0.4).mask(section1).velocity(section1).orbit(3).analyze("arp")
// Wave · bars 17-32 · pattern A
