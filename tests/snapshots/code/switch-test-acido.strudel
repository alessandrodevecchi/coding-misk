// ========== Bass · bass ==========
// Intro · bars 1-16 · pattern A
// Bass · Long sub
$: note("<a1!3 a#1>").transpose(-5).struct("x")
  .s("sawtooth").lpf(sine.range(138, 552).slow(8)).lpq(10.07)
  .decay(.6).sustain(.8).gain(0.8).mask(section1).velocity(section1).orbit(2).analyze("bass")
// Wave · bars 17-32 · pattern A
