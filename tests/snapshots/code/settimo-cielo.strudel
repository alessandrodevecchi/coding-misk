// coding-misk · Settimo Cielo
// track composed with the arranger: each scene is a block of layers switched on by its lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(120/4)

const SECTIONS = [['Mellotron', 4], ['Riff 7/8', 8], ['Strofa 7/8', 8], ['Ponte 5/4', 6], ['Assolo 4/4', 8], ['Riff ripresa', 4], ['Finale', 4]]
const TEMPO = {'Mellotron': 120, 'Riff 7/8': 137.14, 'Strofa 7/8': 137.14, 'Ponte 5/4': 96, 'Assolo 4/4': 124, 'Riff ripresa': 137.14, 'Finale': [[1,120],[1,110.67],[1,101.33],[1,92]]}

// ---------- 1 · Mellotron · 4 bars · 120 BPM · A · Am G F E ----------
const scene1 = "<1!4 0!38>"

// Hook · Prog
$: n("<[0 2 4 ~ 4 5 4 0] [3 2 0 ~ -1 0 2 3] [4 5 7 ~ 7 9 7 4] [5 4 2 ~ 0 -1 0 5]>").scale("A4:minor")
  .s("gm_flute").lpf(6000)
  .decay(.2).sustain(.3).delay(.25).room(.3).gain(0.4).mask(scene1).velocity(scene1).analyze("hook")

// Pad · Sustained
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g#2,b2,e3]>")
  .s("gm_string_ensemble_1").attack(.4).release(1.2).lpf(3000)
  .room(.8).gain("<0.1 0.17 0.25 0.32>").mask(scene1).velocity(scene1).analyze("pad")

// ---------- 2 · Riff 7/8 · 8 (7/8) bars · 120 BPM · A · Am C D F ----------
const scene2 = "<0!4 1!8 0!30>"
// Drums · AkaiXR10
$: s("bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~").bank("AkaiXR10").gain(0.9).distort(0.3).distortvol(.5).mask(scene2).velocity(scene2).analyze("kick")
$: s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~").bank("AkaiXR10").gain(0.68).distort(0.3).distortvol(.5).mask(scene2).velocity(scene2).analyze("snare")
$: s("hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~").bank("AkaiXR10").gain(0.45).distort(0.3).distortvol(.5).mask(scene2).velocity(scene2).analyze("hats")
$: s("cr").bank("AkaiXR10").gain(.55).room(.4).mask("<0!4 1 0!3>").mask(scene2).velocity(scene2).analyze("fx")

// Bass · 8th notes (rock)
$: note("<a1 c2 d2 f1>").struct("[x x]@4 [x x]@4 [x x]@4 x@2")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.25).sustain(.5).gain(0.9).mask(scene2).velocity(scene2).analyze("bass")

// Guitar · Distorted, Riff
$: note("<[a2,e3,a3] [c3,g3,c4] [d3,a3,d4] [f2,c3,f3]>").struct("x ~ x x ~ x ~ x x ~ x ~ x x")
  .s("gm_distortion_guitar,sawtooth").attack(.003).decay(0.09).sustain(0).release(.08)
  .distort(3).distortvol(.2).hpf(80).lpf(4200).jux(x => x.late(.012))
  .room(.2).gain(.8).mask(scene2).postgain(scene2.mul(0.8)).analyze("guitar")

// ---------- 3 · Strofa 7/8 · 8 (7/8) bars · 120 BPM · A · Am C D F ----------
const scene3 = "<0!12 1!8 0.5 0!21>"
// Drums · AkaiXR10
$: s("bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~").bank("AkaiXR10").gain(0.9).distort(0.3).distortvol(.5).mask(scene3).velocity(scene3).analyze("kick")
$: s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~").bank("AkaiXR10").gain(0.68).distort(0.3).distortvol(.5).mask(scene3).velocity(scene3).analyze("snare")
$: s("rd ~ rd ~ rd ~ rd ~ rd ~ rd ~ rd ~").bank("AkaiXR10").gain(0.32).distort(0.3).distortvol(.5).mask(scene3).velocity(scene3).analyze("hats")

// Bass · 8th notes (rock)
$: note("<a1 c2 d2 f1>").struct("[x x]@4 [x x]@4 [x x]@4 x@2")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.25).sustain(.5).gain(0.85).mask(scene3).velocity(scene3).analyze("bass")

// Arpeggio · Up, 8ths
$: note("<[a3 c4 e4 a4 a3 c4 e4] [g3 c4 e4 g4 g3 c4 e4] [a3 d4 f#4 a4 a3 d4 f#4] [f3 a3 c4 f4 f3 a3 c4]>")
  .s("gm_rock_organ").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).delay(.15).gain(0.4).mask(scene3).velocity(scene3).analyze("arp")

// Hook · Prog
$: n("<[0 2 4 ~ 4 5 4] [3 2 0 ~ -1 0 2] [4 5 7 ~ 7 9 7] [5 4 2 ~ 0 -1 0]>").scale("A4:minor")
  .s("gm_lead_2_sawtooth").lpf(6000)
  .decay(.2).sustain(.3).delay(.25).room(.3).gain(0.4).mask(scene3).velocity(scene3).analyze("hook")

// Guitar · Crunch, Held
$: note("<[a2,e3,a3] [c3,g3,c4] [d3,a3,d4] [f2,c3,f3]>")
  .s("gm_overdriven_guitar,sawtooth").attack(.003).decay(1.5).sustain(0.8).release(.08)
  .distort(1.5).distortvol(.2).hpf(70).lpf(4200).jux(x => x.late(.012))
  .room(.2).gain(.8).mask(scene3).postgain(scene3.mul(0.55)).analyze("guitar")

// ---------- 4 · Ponte 5/4 · 6 (5/4) bars · 120 BPM · A · Am G F E · fades in over 1 bars ----------
const scene4 = "<0!20 0.5 1!5 0!16>"
// Drums · AkaiXR10
$: s("[bd ~ ~ ~] ~ [~ ~ bd ~] ~ ~").bank("AkaiXR10").gain(0.9).distort(0.3).distortvol(.5).mask(scene4).velocity(scene4).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ ~] [sd ~ ~ ~]").bank("AkaiXR10").gain(0.68).distort(0.3).distortvol(.5).mask(scene4).velocity(scene4).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("AkaiXR10").gain(0.45).distort(0.3).distortvol(.5).mask(scene4).velocity(scene4).analyze("hats")
$: s("sd*20").bank("AkaiXR10").gain(saw.range(.15, .75)).mask("<0 1 0!4>").mask(scene4).velocity(scene4).analyze("snare")

// Bass · Walking (quarters)
$: note("<a1 g1 f1 e1>").struct("x x x x x")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.4).sustain(.3).gain(0.9).mask(scene4).velocity(scene4).analyze("bass")

// Arpeggio · Broken, 16ths
$: note("<[a3 e4 c4 a4 e4 a3 a4 c4 a3 e4 c4 a4 e4 a3 a4 c4 a3 e4 c4 a4] [g3 d4 b3 g4 d4 g3 g4 b3 g3 d4 b3 g4 d4 g3 g4 b3 g3 d4 b3 g4] [f3 c4 a3 f4 c4 f3 f4 a3 f3 c4 a3 f4 c4 f3 f4 a3 f3 c4 a3 f4] [g#3 e4 b3 g#4 e4 g#3 g#4 b3 g#3 e4 b3 g#4 e4 g#3 g#4 b3 g#3 e4 b3 g#4]>")
  .s("gm_electric_guitar_clean").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).delay(.15).gain(0.3).mask(scene4).velocity(scene4).analyze("arp")

// Pad · Sustained
$: note("<[a2,c3,e3] [g2,b2,d3] [f2,a2,c3] [g#2,b2,e3]>")
  .s("gm_drawbar_organ").attack(.4).release(1.2).lpf(4000)
  .room(.5).gain(0.26).mask(scene4).velocity(scene4).analyze("pad")

// ---------- 5 · Assolo 4/4 · 8 bars · 124 BPM · A · Am G F E ----------
const scene5 = "<0!26 1!8 0!8>"
// Drums · AkaiXR10
$: s("[bd ~ ~ ~] ~ [bd ~ bd ~] ~").bank("AkaiXR10").gain(0.9).distort(0.3).distortvol(.5).mask(scene5).velocity(scene5).analyze("kick")
$: s("~ [sd ~ ~ ~] ~ [sd ~ ~ ~]").bank("AkaiXR10").gain(0.68).distort(0.3).distortvol(.5).mask(scene5).velocity(scene5).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("AkaiXR10").gain(0.45).distort(0.3).distortvol(.5).mask(scene5).velocity(scene5).analyze("hats")
$: s("~ ~ ~ [~ ~ oh ~]").bank("AkaiXR10").gain(0.41).distort(0.3).distortvol(.5).mask(scene5).velocity(scene5).analyze("hats")
$: s("sd*16").bank("AkaiXR10").gain(saw.range(.15, .75)).mask("<0 1 0!6>").mask(scene5).velocity(scene5).analyze("snare")
$: s("cr").bank("AkaiXR10").gain(.55).room(.4).mask("<0!2 1 0!5>").mask(scene5).velocity(scene5).analyze("fx")

// Bass · 8th notes (rock)
$: note("<f1 e1 a1 g1>").struct("[x x] [x x] [x x] [x x]")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.25).sustain(.5).gain(0.9).mask(scene5).velocity(scene5).analyze("bass")

// Hook · Solo
$: n("<[9 7 4 3 4 2 0 -1] [0 ~ 7 ~ 4 ~ 0 ~] [0 2 3 4 7 4 3 2] [0 2 3 4 7 9 7 4]>").scale("A4:dorian")
  .s("gm_distortion_guitar,sawtooth").distort(2.5).distortvol(.5).lpf(6000)
  .decay(.2).sustain(.3).delay(.25).room(.3).gain(0.4).mask(scene5).velocity(scene5).analyze("hook")

// Guitar · Crunch, Power chords, 8ths
$: note("<[f2,c3,f3] [e2,b2,e3] [a2,e3,a3] [g2,d3,g3]>").struct("[x x] [x x] [x x] [x x]")
  .s("gm_overdriven_guitar,sawtooth").attack(.003).decay(0.3).sustain(0.55).release(.08)
  .distort(1.5).distortvol(.2).hpf(70).lpf(4200).jux(x => x.late(.012))
  .room(.2).gain(.8).mask(scene5).postgain(scene5.mul(0.7)).analyze("guitar")

// Pad · Sustained
$: note("<[f2,a2,c3] [g#2,b2,e3] [a2,c3,e3] [g2,b2,d3]>")
  .s("gm_drawbar_organ").attack(.4).release(1.2).lpf(3000)
  .room(.4).gain(0.18).mask(scene5).velocity(scene5).analyze("pad")

// ---------- 6 · Riff ripresa · 4 (7/8) bars · 120 BPM · A · Am C D F ----------
const scene6 = "<0!34 1!4 0!4>"
// Drums · AkaiXR10
$: s("bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~").bank("AkaiXR10").gain(0.9).distort(0.3).distortvol(.5).mask(scene6).velocity(scene6).analyze("kick")
$: s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~").bank("AkaiXR10").gain(0.68).distort(0.3).distortvol(.5).mask(scene6).velocity(scene6).analyze("snare")
$: s("hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~").bank("AkaiXR10").gain(0.45).distort(0.3).distortvol(.5).mask(scene6).velocity(scene6).analyze("hats")
$: s("cr").bank("AkaiXR10").gain(.55).room(.4).mask("<0!2 1 0>").mask(scene6).velocity(scene6).analyze("fx")

// Bass · 8th notes (rock)
$: note("<d2 f1 a1 c2>").struct("[x x]@4 [x x]@4 [x x]@4 x@2")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.25).sustain(.5).gain(0.9).mask(scene6).velocity(scene6).analyze("bass")

// Arpeggio · Pulsar, 8ths
$: note("<[a3 a4 d4 a4 f#4 a4 d4] [f3 f4 a3 f4 c4 f4 a3] [a3 a4 c4 a4 e4 a4 c4] [g3 g4 c4 g4 e4 g4 c4]>")
  .s("gm_rock_organ").lpf(4000).lpq(1)
  .decay(.15).sustain(.15).delay(.15).gain(0.38).mask(scene6).velocity(scene6).analyze("arp")

// Guitar · Distorted, Riff
$: note("<[d3,a3,d4] [f2,c3,f3] [a2,e3,a3] [c3,g3,c4]>").struct("x ~ x x ~ x ~ x x ~ x ~ x x")
  .s("gm_distortion_guitar,sawtooth").attack(.003).decay(0.09).sustain(0).release(.08)
  .distort(3).distortvol(.2).hpf(80).lpf(4200).jux(x => x.late(.012))
  .room(.2).gain(.8).mask(scene6).postgain(scene6.mul(0.85)).analyze("guitar")

// ---------- 7 · Finale · 4 bars · 120→92 BPM · A · Am G F E ----------
const scene7 = "<0!38 1!4>"
// Drums · AkaiXR10
$: s("[bd ~ ~ ~] ~ [bd ~ ~ ~] ~").bank("AkaiXR10").gain("<0.57 0.4 0.9 0.73>").distort(0.3).distortvol(.5).mask(scene7).velocity(scene7).analyze("kick")
$: s("~ ~ [sd ~ ~ ~] ~").bank("AkaiXR10").gain("<0.43 0.3 0.68 0.55>").distort(0.3).distortvol(.5).mask(scene7).velocity(scene7).analyze("snare")
$: s("[rd ~ ~ ~] [rd ~ ~ ~] [rd ~ ~ ~] [rd ~ ~ ~]").bank("AkaiXR10").gain("<0.2 0.14 0.32 0.26>").distort(0.3).distortvol(.5).mask(scene7).velocity(scene7).analyze("hats")
$: s("cr").bank("AkaiXR10").gain(.55).room(.4).mask("<0!2 1 0>").mask(scene7).velocity(scene7).analyze("fx")

// Bass · Long sub
$: note("<f1 e1 a1 g1>").struct("x")
  .s("gm_electric_bass_pick").lpf(2000).lpq(1).distort(0.4).distortvol(.5)
  .decay(.6).sustain(.8).gain(0.9).mask(scene7).velocity(scene7).analyze("bass")

// Hook · Prog
$: n("<[4 5 7 ~ 7 9 7 4] [5 4 2 ~ 0 -1 0 5] [0 2 4 ~ 4 5 4 0] [3 2 0 ~ -1 0 2 3]>").scale("A4:minor")
  .s("gm_string_ensemble_1").lpf(5000)
  .decay(.2).sustain(.3).delay(.3).room(.3).gain("<0.07 0 0.2 0.13>").mask(scene7).velocity(scene7).analyze("hook")

// Guitar · Distorted, Held
$: note("<[f2,c3,f3] [e2,b2,e3] [a2,e3,a3] [g2,d3,g3]>")
  .s("gm_distortion_guitar,sawtooth").attack(.003).decay(1.5).sustain(0.8).release(.08)
  .distort(3).distortvol(.2).hpf(80).lpf(4200).jux(x => x.late(.012))
  .room(.2).gain(.8).mask(scene7).postgain(scene7.mul("<0.37 0.15 0.8 0.58>")).analyze("guitar")

// Pad · Sustained
$: note("<[f2,a2,c3] [g#2,b2,e3] [a2,c3,e3] [g2,b2,d3]>")
  .s("gm_string_ensemble_1").attack(.4).release(1.2).lpf(4000)
  .room(.8).gain("<0.12 0.05 0.25 0.18>").mask(scene7).velocity(scene7).analyze("pad")
