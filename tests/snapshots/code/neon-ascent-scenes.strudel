// coding-misk · Neon Ascent
// track composed with the arranger: each scene is a block of layers switched on by its lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(128/4)

const SECTIONS = [['Intro', 4], ['Build', 8], ['Drop', 8], ['Break', 4], ['Drop 2', 8]]
const TEMPO = {'Intro': 128, 'Build': 128, 'Drop': 128, 'Break': 128, 'Drop 2': 128}

// ---------- 1 · Intro · 4 bars · 128 BPM · A · Am F C G ----------
const scene1 = "<1!4 0!28>"
// Drums · RolandTR909
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.41).mask(scene1).velocity(scene1).orbit(1).analyze("hats")

// Pad · Sustained
$: note("<[a2,c3,e3] [f2,a2,c3] [g2,c3,e3] [g2,b2,d3]>")
  .s("supersaw").attack(.4).release(1.2).lpf(1400)
  .room(.9).gain(0.3).mask(scene1).velocity(scene1).orbit(6).analyze("pad")

// ---------- 2 · Build · 8 bars · 128 BPM · A · Am F C G ----------
const scene2 = "<0!4 1!8 0!20>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain("<0.84 0.88 0.91 0.95 0.7 0.74 0.77 0.81>").mask(scene2).velocity(scene2).orbit(1).analyze("kick")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain("<0.42 0.44 0.46 0.48 0.35 0.37 0.39 0.4>").mask(scene2).velocity(scene2).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain("<0.38 0.4 0.41 0.43 0.32 0.33 0.35 0.36>").mask(scene2).velocity(scene2).orbit(1).analyze("hats")

// Bass · Rolling
$: note("<a1 f1 c2 g1>").struct("[~ x x x] [~ x x x] [~ x x x] [~ x x x]")
  .s("sawtooth").lpf(sine.range(280, 1120).slow(8)).lpq(10)
  .decay(.12).sustain(0).gain("<0.49 0.61 0.73 0.85 0 0.12 0.24 0.36>").mask(scene2).velocity(scene2).orbit(2).analyze("bass")

// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>")
  .s("supersaw").lpf("<2657.14 3171.43 3685.71 4200 600 1114.29 1628.57 2142.86>").lpq(5)
  .decay(.15).sustain(.15).delay(.3).gain(0.38).mask(scene2).velocity(scene2).orbit(3).analyze("arp")

// Riser · white noise rising over 8 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(4))
  .gain(saw.slow(8).range(0, .3).late(4)).mask(scene2).velocity(scene2).orbit(8).analyze("riser")

// ---------- 3 · Drop · 8 bars · 128 BPM · A · Am F C G ----------
const scene3 = "<0!12 1!8 0.5 0!11>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.9).mask(scene3).velocity(scene3).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.72).mask(scene3).velocity(scene3).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.45).mask(scene3).velocity(scene3).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.41).mask(scene3).velocity(scene3).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!4 1 0!3>").mask(scene3).velocity(scene3).orbit(1).analyze("fx")

// Bass · Rolling
$: note("<a1 f1 c2 g1>").struct("[~ x x x] [~ x x x] [~ x x x] [~ x x x]")
  .s("sawtooth").lpf(sine.range(280, 1120).slow(8)).lpq(10)
  .decay(.12).sustain(0).gain(0.85).mask(scene3).velocity(scene3).orbit(2).analyze("bass")

// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>")
  .s("supersaw").lpf(4200).lpq(5)
  .decay(.15).sustain(.15).delay(.3).gain(0.38).mask(scene3).velocity(scene3).orbit(3).analyze("arp")

// Hook · Neon
$: n("<[0 ~ 0 2 ~ 4 ~ 7] [5 ~ 4 ~ 2 ~ 0 ~] [4 ~ 4 5 ~ 7 ~ 9] [7 ~ 5 ~ 4 2 ~ ~]>").scale("A4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.28).mask(scene3).velocity(scene3).orbit(4).analyze("hook")

// Pad · Offbeat pump
$: note("<[a2,c3,e3] [f2,a2,c3] [g2,c3,e3] [g2,b2,d3]>").struct("[~ x] [~ x] [~ x] [~ x]")
  .s("supersaw").attack(.02).decay(.25).sustain(.2).release(.3).lpf(2200)
  .room(.5).gain(0.3).mask(scene3).velocity(scene3).orbit(6).analyze("pad")

// ---------- 4 · Break · 4 bars · 128 BPM · A · Am F C G · fades in over 1 bars ----------
const scene4 = "<0!20 0.5 1!3 0!8>"

// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>")
  .s("supersaw").lpf(2000).lpq(5)
  .decay(.15).sustain(.15).delay(.3).gain(0.38).mask(scene4).velocity(scene4).orbit(3).analyze("arp")

// Hook · Neon
$: n("<[0 ~ 0 2 ~ 4 ~ 7] [5 ~ 4 ~ 2 ~ 0 ~] [4 ~ 4 5 ~ 7 ~ 9] [7 ~ 5 ~ 4 2 ~ ~]>").scale("A4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.28).mask(scene4).velocity(scene4).orbit(4).analyze("hook")

// Pad · Sustained
$: note("<[a2,c3,e3] [f2,a2,c3] [g2,c3,e3] [g2,b2,d3]>")
  .s("supersaw").attack(.4).release(1.2).lpf(1400)
  .room(.9).gain(0.3).mask(scene4).velocity(scene4).orbit(6).analyze("pad")

// Riser · white noise rising over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000).late(20))
  .gain(saw.slow(4).range(0, .3).late(20)).mask(scene4).velocity(scene4).orbit(8).analyze("riser")

// ---------- 5 · Drop 2 · 8 bars · 128 BPM · A · Am F C G ----------
const scene5 = "<0!24 1!8>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.9).mask(scene5).velocity(scene5).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.72).mask(scene5).velocity(scene5).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.45).mask(scene5).velocity(scene5).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.41).mask(scene5).velocity(scene5).orbit(1).analyze("hats")
$: s("[~ ~ rd ~] [~ ~ rd ~] [~ ~ rd ~] [~ ~ rd ~]").bank("RolandTR909").gain(0.32).mask(scene5).velocity(scene5).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<1 0!7>").mask(scene5).velocity(scene5).orbit(1).analyze("fx")

// Bass · Rolling
$: note("<a1 f1 c2 g1>").struct("[~ x x x] [~ x x x] [~ x x x] [~ x x x]")
  .s("sawtooth").lpf(sine.range(280, 1120).slow(8)).lpq(10)
  .decay(.12).sustain(0).gain(0.85).mask(scene5).velocity(scene5).orbit(2).analyze("bass")

// Arpeggio · Up, 16ths
$: note("<[a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4 a3 c4 e4 a4] [f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4 f3 a3 c4 f4] [g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4 g3 c4 e4 g4] [g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4 g3 b3 d4 g4]>")
  .s("supersaw").lpf(4200).lpq(5)
  .decay(.15).sustain(.15).delay(.3).gain(0.38).mask(scene5).velocity(scene5).orbit(3).analyze("arp")

// Hook · Neon
$: n("<[0 ~ 0 2 ~ 4 ~ 7] [5 ~ 4 ~ 2 ~ 0 ~] [4 ~ 4 5 ~ 7 ~ 9] [7 ~ 5 ~ 4 2 ~ ~]>").scale("A4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.4).room(.3).gain(0.28).mask(scene5).velocity(scene5).orbit(4).analyze("hook")

// Pad · Offbeat pump
$: note("<[a2,c3,e3] [f2,a2,c3] [g2,c3,e3] [g2,b2,d3]>").struct("[~ x] [~ x] [~ x] [~ x]")
  .s("supersaw").attack(.02).decay(.25).sustain(.2).release(.3).lpf(2200)
  .room(.5).gain(0.3).mask(scene5).velocity(scene5).orbit(6).analyze("pad")
