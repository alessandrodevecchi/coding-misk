// coding-misk · Next Chapter
// track composed with the arranger: each scene is a block of layers switched on by its lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(96/4)

const SECTIONS = [['Intro', 4], ['Strofa', 8], ['Pre', 4], ['Drop', 16], ['Break', 8], ['Riser', 2], ['Drop 2', 16], ['Outro', 4]]
const TEMPO = {'Intro': 96, 'Strofa': 96, 'Pre': 96, 'Drop': 96, 'Break': 96, 'Riser': 96, 'Drop 2': 96, 'Outro': 96}

// ---------- 1 · Intro · 4 bars · 96 BPM · B · G G A A Bm Bm F#m F#m ----------
const scene1 = "<1!4 0.5 0!57>"

// Arpeggio · Up and down, 16ths
$: note("<[f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3]>").transpose(2)
  .s("triangle").lpf("<900 1333.33 1766.67 2200>").lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain("<0.12 0.17 0.21 0.26>").mask(scene1).velocity(scene1).analyze("arp")

// Pad · Sustained
$: note("<[f2,a2,c3] [f2,a2,c3] [g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [g2,b2,e3] [g2,b2,e3]>").transpose(2)
  .s("supersaw").attack(.4).release(1.2).lpf("<500 933.33 1366.67 1800>")
  .room(.9).gain("<0.18 0.22 0.26 0.3>").mask(scene1).velocity(scene1).analyze("pad")

// ---------- 2 · Strofa · 8 bars · 96 BPM · B · G G A A Bm Bm F#m F#m · fades in over 1 bars ----------
const scene2 = "<0!4 0.5 1!7 0!50>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(scene2).velocity(scene2).analyze("kick")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.43).mask(scene2).velocity(scene2).analyze("hats")

// Bass · Pumping (sidechain)
$: note("<a1 a1 e1 e1 f1 f1 g1 g1>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.6).mask(scene2).velocity(scene2).analyze("bass")

// Arpeggio · Up and down, 16ths
$: note("<[a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3]>").transpose(2)
  .s("triangle").lpf(2400).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.28).mask(scene2).velocity(scene2).analyze("arp")

// Pad · Sidechain
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,e3] [g2,b2,e3] [f2,a2,c3] [f2,a2,c3] [g2,b2,d3] [g2,b2,d3]>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf("<2257.14 2371.43 2485.71 2600 1800 1914.29 2028.57 2142.86>")
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.28).mask(scene2).velocity(scene2).analyze("pad")

// ---------- 3 · Pre · 4 bars · 96 BPM · B · Bm Bm A A ----------
const scene3 = "<0!12 1!4 0!46>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask("<1!3 [1 0]>").mask(scene3).velocity(scene3).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask("<1!3 [1 0]>").mask(scene3).velocity(scene3).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("RolandTR909").gain(0.43).mask("<1!3 [1 0]>").mask(scene3).velocity(scene3).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0!3 1>").mask(scene3).velocity(scene3).analyze("snare")

// Bass · Pumping (sidechain)
$: note("<a1 a1 g1 g1>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.6).mask("<1!3 [1 0]>").mask(scene3).velocity(scene3).analyze("bass")

// Arpeggio · Up and down, 16ths
$: note("<[a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3]>").transpose(2)
  .s("triangle").lpf(2600).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.28).mask("<1!3 [1 0]>").mask(scene3).velocity(scene3).analyze("arp")

// Pad · Sidechain
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf("<2600 2933.33 3266.67 3600>")
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.3).mask(scene3).velocity(scene3).analyze("pad")

// Riser · white noise rising over 4 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(4).range(300, 8000).late(12))
  .gain(saw.slow(4).range(0, .35).late(12)).mask(scene3).velocity(scene3).analyze("riser")

// ---------- 4 · Drop · 16 bars · 96 BPM · B · G G A A Bm Bm F#m F#m ----------
const scene4 = "<0!16 1!16 0.67 0.33 0!28>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(scene4).velocity(scene4).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask(scene4).velocity(scene4).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.43).mask(scene4).velocity(scene4).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.38).mask(scene4).velocity(scene4).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0!15 1>").mask(scene4).velocity(scene4).analyze("snare")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<1 0!15>").mask(scene4).velocity(scene4).analyze("fx")

// Bass · Pumping (sidechain)
$: note("<f1 f1 g1 g1 a1 a1 e1 e1>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("sine").lpf(600).lpq(2)
  .decay(.2).sustain(.6).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.8).mask(scene4).velocity(scene4).analyze("bass")

// Arpeggio · Up and down, 16ths
$: note("<[f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [f3 a3 c4 f4 c4 a3 f3 a3 f3 a3 c4 f4 c4 a3 f3 a3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [g3 b3 d4 g4 d4 b3 g3 b3 g3 b3 d4 g4 d4 b3 g3 b3] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [a3 c4 e4 a4 e4 c4 a3 c4 a3 c4 e4 a4 e4 c4 a3 c4] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3] [g3 b3 e4 g4 e4 b3 g3 b3 g3 b3 e4 g4 e4 b3 g3 b3]>").transpose(2)
  .s("triangle").lpf(3000).lpq(2)
  .decay(.15).sustain(.15).delay(.35).gain(0.28).mask(scene4).velocity(scene4).analyze("arp")

// Hook · Horizon
$: n("<[4 ~ 4 5 4 ~ 2 ~] [0 ~ 2 ~ 4 ~ 7 ~] [5 ~ 5 4 2 ~ 0 ~] [1 ~ 2 ~ 4 ~ ~ ~]>").scale("B4:minor")
  .s("square").lpf(3200)
  .decay(.2).sustain(.3).delay(.3).room(.3).gain(0.27).mask(scene4).velocity(scene4).analyze("hook")

// Pad · Sidechain
$: note("<[f2,a2,c3] [f2,a2,c3] [g2,b2,d3] [g2,b2,d3] [a2,c3,e3] [a2,c3,e3] [g2,b2,e3] [g2,b2,e3]>").transpose(2).struct("[x x x x] [x x x x] [x x x x] [x x x x]")
  .s("supersaw").attack(.01).decay(.2).sustain(.7).release(.05).lpf(3400)
  .room(.45).postgain("[.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1] [.1 .4 .75 1]").gain(0.34).mask(scene4).velocity(scene4).analyze("pad")

// ---------- 5 · Break · 8 bars · 96 BPM · B · Bm Bm A A · fades in over 2 bars ----------
const scene5 = "<0!32 0.33 0.67 1!6 0!22>"
// Drums · RolandTR909
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.43).mask(scene5).velocity(scene5).analyze("hats")

// Bass · Long sub
$: note("<a1 a1 g1 g1>").transpose(2).struct("x")
  .s("sine").lpf(400).lpq(2)
  .decay(.6).sustain(.8).gain(0.4).mask(scene5).velocity(scene5).analyze("bass")

// Hook · Horizon
$: n("<[4 ~ 4 5 4 ~ 2 ~] [0 ~ 2 ~ 4 ~ 7 ~] [5 ~ 5 4 2 ~ 0 ~] [1 ~ 2 ~ 4 ~ ~ ~]>").scale("B4:minor")
  .s("square").lpf(1800)
  .decay(.2).sustain(.3).delay(.5).room(.3).gain(0.2).mask(scene5).velocity(scene5).analyze("hook")

// Pad · Sustained
$: note("<[a2,c3,e3] [a2,c3,e3] [g2,b2,d3] [g2,b2,d3]>").transpose(2)
  .s("supersaw").attack(.4).release(1.2).lpf("<1200 1371.43 1542.86 1714.29 1885.71 2057.14 2228.57 2400>")
  .room(.9).gain(0.3).mask(scene5).velocity(scene5).analyze("pad")

// ---------- 6 · Riser · 2 bars · 96 BPM · B · Bm Bm A A ----------
