  .gain(saw.slow(2).range(0, .4).late(40)).mask(scene6).velocity(scene6).analyze("riser")

// ---------- 7 · Drop 2 · 16 bars · 96 BPM · C · G# G# A# A# Cm Cm Gm Gm ----------
const scene7 = "<0!42 1!16 0!4>"
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.85).mask(scene7).velocity(scene7).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.68).mask(scene7).velocity(scene7).analyze("snare")
