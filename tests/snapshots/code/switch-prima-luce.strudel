// coding-misk · Prima luce
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(140/4)

const SECTIONS = [['Loop', 32], ['Salita', 32], ['Respiro', 8], ['Luce', 24]]
const TEMPO = {'Loop': 140, 'Salita': 140, 'Respiro': 140, 'Luce': 140}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!32 0!64>"  // Loop · 32 bars · 140 BPM · G · Gm
const section2 = "<0!32 1!32 0!32>"  // Salita · 32 bars · 140 BPM · G · Gm Gm F F
const section3 = "<0!64 1!8 0!24>"  // Respiro · 8 bars · 140 BPM · G · Gm Gm F F
const section4 = "<0!72 1!24>"  // Luce · 24 bars · 140 BPM · G · Gm Gm F F

// ========== drums ==========
// Loop · bars 1-32 · pattern floor
// Drums · RolandTR909
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(0.4).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("kick")
$: s("[~ cp]*2").bank("RolandTR909").gain(0.68).distort(0.4).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("snare")
$: s("[~ hh]*4").bank("RolandTR909").gain(0.43).distort(0.4).distortvol(.5).mask(section1).velocity(section1).orbit(1).analyze("hats")
// Salita · bars 33-64 · pattern floor
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(0.4).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("[~ cp]*2").bank("RolandTR909").gain(0.68).distort(0.4).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("snare")
$: s("[~ hh]*4").bank("RolandTR909").gain(0.43).distort(0.4).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("hats")
$: s("sd*16").bank("RolandTR909").gain(saw.range(.15, .75)).mask("<0!31 1>").mask(section2).velocity(section2).orbit(1).analyze("snare")
// Luce · bars 73-96 · pattern floor
$: s("bd*4").bank("RolandTR909").gain(0.85).distort(0.4).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("[~ cp]*2").bank("RolandTR909").gain(0.68).distort(0.4).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[~ hh]*4").bank("RolandTR909").gain(0.43).distort(0.4).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<1 0!23>").mask(section4).velocity(section4).orbit(1).analyze("fx")

// ========== bass ==========
// Loop · bars 1-32 · pattern roll
// Bass · notes written by hand
$: note("[~ a3!3]*4").transpose(-26)
  .s("supersaw").lpf(sine.range(360, 1440).slow(8)).lpq(10).distort(0.6).distortvol(.5)
  .decay(.12).sustain(0).gain(0.6).mask(section1).velocity(section1).orbit(2).analyze("bass")
// Salita · bars 33-64 · pattern roll
$: note("[~ 0 0 0]*4".add("<57!2 55!2>")).transpose(-26)
  .s("supersaw").lpf(sine.range(360, 1440).slow(8)).lpq(10).distort(0.6).distortvol(.5)
  .decay(.12).sustain(0).gain(0.6).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Luce · bars 73-96 · pattern roll
$: note("[~ 0 0 0]*4".add("<57!2 55!2>")).transpose(-26)
  .s("supersaw").lpf(sine.range(360, 1440).slow(8)).lpq(10).distort(0.6).distortvol(.5)
  .decay(.12).sustain(0).gain(0.6).mask(section4).velocity(section4).orbit(2).analyze("bass")

// ========== lead · hook ==========
// Loop · bars 1-32 · pattern call
// Hook · notes written by hand
$: n("0 ~ 1 ~ 2 3 ~ 2").scale("G4:minor")
  .s("supersaw").lpf(2600)
  .decay(.2).sustain(.3).delay(.6).room(.3).gain(0.3).mask(section1).velocity(section1).orbit(4).analyze("hook")
// Salita · bars 33-64 · pattern call
$: n("0 ~ 1 ~ 2 3 ~ 2").scale("G4:minor")
  .s("supersaw").lpf(2600)
  .decay(.2).sustain(.3).delay(.6).room(.3).gain(0.3).mask(section2).velocity(section2).orbit(4).analyze("hook")
// Respiro · bars 65-72 · pattern call
$: n("0 ~ 1 ~ 2 3 ~ 2").scale("G4:minor")
  .s("supersaw").lpf(2600)
  .decay(.2).sustain(.3).delay(.6).room(.3).gain(0.3).mask("<1!7 [1 0]>").mask(section3).velocity(section3).orbit(4).analyze("hook")
// Luce · bars 73-96 · pattern call
$: n("0 ~ 1 ~ 2 3 ~ 2").scale("G4:minor")
  .s("supersaw").lpf(2600)
  .decay(.2).sustain(.3).delay(.6).room(.3).gain(0.3).mask(section4).velocity(section4).orbit(4).analyze("hook")

// ========== arp ==========
// Salita · bars 33-64 · pattern climb
// Arpeggio · notes written by hand, 16ths
$: note("<[a3,c4,e4,a4]!2 [g3,b3,d4,g4]!2>").arp("[0 1 2 3 2 1 0 2]*2").transpose(-2)
  .s("supersaw").lpf(sine.range(800, 3200).slow(8)).lpq(4)
  .decay(.15).sustain(.15).delay(.5).gain(0.28).mask(section2).velocity(section2).orbit(3).analyze("arp")
// Luce · bars 73-96 · pattern climb
$: note("<[a3,c4,e4,a4]!2 [g3,b3,d4,g4]!2>").arp("[0 1 2 3 2 1 0 2]*2").transpose(-2)
  .s("supersaw").lpf(sine.range(800, 3200).slow(8)).lpq(4)
  .decay(.15).sustain(.15).delay(.5).gain(0.28).mask(section4).velocity(section4).orbit(3).analyze("arp")

// ========== pad ==========
// Loop · bars 1-32 · pattern hold
// Pad · Sustained
$: note("[a2,c3,e3]").transpose(-2)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(560, 2240).slow(8))
  .room(.8).gain(0.22).mask(section1).velocity(section1).orbit(6).analyze("pad")
// Salita · bars 33-64 · pattern hold
$: note("<[a2,c3,e3]!2 [g2,b2,d3]!2>").transpose(-2)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(560, 2240).slow(8))
  .room(.8).gain(0.22).mask(section2).velocity(section2).orbit(6).analyze("pad")
// Respiro · bars 65-72 · pattern hold
$: note("<[a2,c3,e3]!2 [g2,b2,d3]!2>").transpose(-2)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(560, 2240).slow(8))
  .room(.8).gain(0.22).mask(section3).velocity(section3).orbit(6).analyze("pad")
// Luce · bars 73-96 · pattern hold
$: note("<[a2,c3,e3]!2 [g2,b2,d3]!2>").transpose(-2)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(560, 2240).slow(8))
  .room(.8).gain(0.22).mask(section4).velocity(section4).orbit(6).analyze("pad")

// ========== riser ==========
const clip1 = "<0!56 1!8 0!32>"
// Salita · bars 57-64 · pattern up
// Riser · white noise rising over 8 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(56))
  .gain(saw.slow(8).range(0, .25).late(56)).mask(clip1).velocity(clip1).orbit(8).analyze("riser")
