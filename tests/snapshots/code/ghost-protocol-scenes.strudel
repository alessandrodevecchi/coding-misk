$: note("<[a3 a3 [a4 a3] c4 a3 e4 [a3 a4] c4] [f3 f3 [f4 f3] a3 f3 c4 [f3 f4] a3] [g3 g3 [g4 g3] b3 g3 d4 [g3 g4] b3] [g#3 g#3 [g#4 g#3] b3 g#3 e4 [g#3 g#4] b3]>").transpose(-5)
  .s("sawtooth").lpf("<300 657.14 1014.29 1371.43 1728.57 2085.71 2442.86 2800>").lpq(20).distort(1).distortvol(.5)
  .decay(.15).sustain(.15).gain("<0.3 0.31 0.32 0.33 0.35 0.36 0.37 0.38>").mask("<1!7 [1 0]>").mask(section2).velocity(section2).orbit(3).analyze("arp")
