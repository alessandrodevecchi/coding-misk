// ========== pad ==========
// Intro · bars 1-8 · pattern A
// Pad · Sustained
$: note("<[a2,c3,e3] [f2,a2,c3] [g2,b2,d3] [g#2,b2,e3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf("<500 628.57 757.14 885.71 1014.29 1142.86 1271.43 1400>")
  .room(.9).gain("<0.05 0.08 0.12 0.15 0.18 0.21 0.25 0.28>").mask(section1).velocity(section1).orbit(6).analyze("pad")
