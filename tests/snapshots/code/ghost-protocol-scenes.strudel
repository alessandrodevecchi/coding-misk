  .s("square").fm(2).vowel("<a e i o>").lpf(3500)
  .decay(.2).sustain(.3).delay(.45).room(.3).gain("<0.17 0.2 0.22 0.24 0 0.02 0.04 0.07 0.09 0.11 0.13 0.15>").mask(section3).velocity(section3).orbit(4).analyze("hook")
