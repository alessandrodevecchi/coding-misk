// coding-misk · Ghost Protocol
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(132/4)

const SECTIONS = [['Intro', 8], ['Build', 8], ['Drop A', 12], ['Fall', 2], ['Break', 6], ['Rebuild', 8], ['Drop B', 12], ['Outro', 4]]
const TEMPO = {'Intro': 132, 'Build': [[1,133],[1,134],[1,134],[1,135.2],[1,136.4],[1,137.6],[1,138.8],[1,140]], 'Drop A': 140, 'Fall': 140, 'Break': 140, 'Rebuild': [[1,140.5],[1,141],[1,141],[1,142.4],[1,143.8],[1,145.2],[1,146.6],[1,148]], 'Drop B': 148, 'Outro': 148}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!8 0.67 0.33 0!50>"  // Intro · 8 bars · 132 BPM · E · Em C D B
const section2 = "<0!8 0.33 0.67 1!6 0!44>"  // Build · 8 bars · 134→140 BPM · E · Em C D B · fades in over 2 bars
const section3 = "<0!16 1!12 0!32>"  // Drop A · 12 bars · 140 BPM · E · Em C D B
const section4 = "<0!28 1!2 0.5 0!29>"  // Fall · 2 bars · 140 BPM · E · Em C D B
const section5 = "<0!30 0.5 1!5 0.67 0.33 0!22>"  // Break · 6 bars · 140 BPM · E · Em C D B · fades in over 1 bars
const section6 = "<0!36 0.33 0.67 1!6 0!16>"  // Rebuild · 8 bars · 141→148 BPM · E · Em C D B · fades in over 2 bars
const section7 = "<0!44 1!12 0!4>"  // Drop B · 12 bars · 148 BPM · F · Fm C# D# C
const section8 = "<0!56 1!4>"  // Outro · 4 bars · 148 BPM · F · Fm C# D# C

// ========== drums ==========
// Intro · bars 1-8 · pattern A
// Drums · RolandTR606
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR606").gain("<0.3 0.33 0.36 0.39 0.41 0.44 0.47 0.5>").crush(4).mask(section1).velocity(section1).orbit(1).analyze("hats")
// Build · bars 9-16 · pattern B
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.9).distort(1.6).distortvol(.5).mask("<1!7 [1 0]>").mask(section2).velocity(section2).orbit(1).analyze("kick")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain(0.45).distort(1.6).distortvol(.5).mask("<1!7 [1 0]>").mask(section2).velocity(section2).orbit(1).analyze("hats")
// Drop A · bars 17-28 · pattern C
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.9).distort(1.6).distortvol(.5).crush(11).mask(section3).velocity(section3).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain(0.72).distort(1.6).distortvol(.5).crush(11).mask(section3).velocity(section3).orbit(1).analyze("snare")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain(0.45).distort(1.6).distortvol(.5).crush(11).mask(section3).velocity(section3).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.41).distort(1.6).distortvol(.5).crush(11).mask(section3).velocity(section3).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!4 1 0!7>").mask(section3).velocity(section3).orbit(1).analyze("fx")
// Fall · bars 29-30 · pattern D
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain("<0.9 0.3>").distort(1.6).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ ~]").bank("RolandTR909").gain("<0.72 0.24>").distort(1.6).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("RolandTR909").gain("<0.45 0.15>").distort(1.6).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("hats")
// Break · bars 31-36 · pattern E
// Drums · LinnDrum
$: s("[bd ~ ~ ~] ~ [~ ~ bd ~] ~").bank("LinnDrum").gain(0.75).crush(5).mask(section5).velocity(section5).orbit(1).analyze("kick")
$: s("~ ~ [cp ~ ~ ~] ~").bank("LinnDrum").gain(0.6).crush(5).mask(section5).velocity(section5).orbit(1).analyze("snare")
$: s("[hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~] [hh ~ hh ~]").bank("LinnDrum").gain(0.38).crush(5).mask(section5).velocity(section5).orbit(1).analyze("hats")
$: s("cr").bank("LinnDrum").gain(.55).room(.4).mask("<1 0!5>").mask(section5).velocity(section5).orbit(1).analyze("fx")
// Rebuild · bars 37-44 · pattern B
// Drums · RolandTR909
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain("<0.73 0.79 0.84 0.9 0.5 0.56 0.61 0.67>").lpf("<11557.14 14371.43 17185.71 20000 300 3114.29 5928.57 8742.86>").distort(1.8).distortvol(.5).mask("<1!3 [1 0] 1!4>").mask(section6).velocity(section6).orbit(1).analyze("kick")
$: s("[~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~] [~ ~ hh ~]").bank("RolandTR909").gain("<0.36 0.39 0.42 0.45 0.25 0.28 0.31 0.34>").lpf("<11557.14 14371.43 17185.71 20000 300 3114.29 5928.57 8742.86>").distort(1.8).distortvol(.5).mask("<1!3 [1 0] 1!4>").mask(section6).velocity(section6).orbit(1).analyze("hats")
// Drop B · bars 45-56 · pattern F
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain(0.9).distort(2).distortvol(.5).crush(8).mask(section7).velocity(section7).orbit(1).analyze("kick")
$: s("~ [cp ~ ~ ~] ~ [cp ~ ~ cp]").bank("RolandTR909").gain(0.72).distort(2).distortvol(.5).crush(8).mask(section7).velocity(section7).orbit(1).analyze("snare")
$: s("[hh ~ hh hh] [~ hh ~ hh] [hh ~ hh hh] [~ hh ~ hh]").bank("RolandTR909").gain(0.45).distort(2).distortvol(.5).crush(8).mask(section7).velocity(section7).orbit(1).analyze("hats")
$: s("[~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~] [~ ~ oh ~]").bank("RolandTR909").gain(0.41).distort(2).distortvol(.5).crush(8).mask(section7).velocity(section7).orbit(1).analyze("hats")
$: s("[~ ~ rd ~] [~ ~ rd ~] [~ ~ rd ~] [~ ~ rd ~]").bank("RolandTR909").gain(0.32).distort(2).distortvol(.5).crush(8).mask(section7).velocity(section7).orbit(1).analyze("hats")
$: s("cr").bank("RolandTR909").gain(.55).room(.4).mask("<0!8 1 0!3>").mask(section7).velocity(section7).orbit(1).analyze("fx")
// Outro · bars 57-60 · pattern G
$: s("[bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~] [bd ~ ~ ~]").bank("RolandTR909").gain("<0.9 0.67 0.43 0.2>").distort(2.5).distortvol(.5).crush(4).mask(section8).velocity(section8).orbit(1).analyze("kick")
$: s("[hh hh hh hh] [hh hh hh hh] [hh hh hh hh] [hh hh hh hh]").bank("RolandTR909").gain("<0.45 0.33 0.22 0.1>").distort(2.5).distortvol(.5).crush(4).mask(section8).velocity(section8).orbit(1).analyze("hats")

// ========== bass ==========
// Intro · bars 1-8 · pattern A
// Bass · Long sub
$: note("<a1 f1 g1 e1>").transpose(-5).struct("x")
  .s("sine").lpf(400).lpq(8)
  .decay(.6).sustain(.8).gain("<0 0.07 0.14 0.21 0.29 0.36 0.43 0.5>").mask(section1).velocity(section1).orbit(2).analyze("bass")
// Build · bars 9-16 · pattern B
// Bass · Rumble
$: note("<a1 f1 g1 e1>").transpose(-5).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf("<200 235.71 271.43 307.14 342.86 378.57 414.29 450>").lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain("<0.2 0.25 0.3 0.35 0.4 0.45 0.5 0.55>").mask("<1!7 [1 0]>").mask(section2).velocity(section2).orbit(2).analyze("bass")
// Drop A · bars 17-28 · pattern B
$: note("<a1 f1 g1 e1>").transpose(-5).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf(450).lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain(0.55).mask(section3).velocity(section3).orbit(2).analyze("bass")
// Fall · bars 29-30 · pattern B
$: note("<a1 f1 g1 e1>").transpose(-5).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf("<450 150>").lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain("<0.55 0.2>").mask(section4).velocity(section4).orbit(2).analyze("bass")
// Break · bars 31-36 · pattern A
// Bass · Long sub
$: note("<g1 e1 a1 f1>").transpose(-5).struct("x")
  .s("sine").lpf(400).lpq(8)
  .decay(.6).sustain(.8).gain(0.6).mask(section5).velocity(section5).orbit(2).analyze("bass")
// Rebuild · bars 37-44 · pattern B
// Bass · Rumble
$: note("<a1 f1 g1 e1>").transpose(-5).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf("<350 400 450 500 150 200 250 300>").lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain("<0.4 0.45 0.5 0.55 0.2 0.25 0.3 0.35>").mask("<1!3 [1 0] 1!4>").mask(section6).velocity(section6).orbit(2).analyze("bass")
// Drop B · bars 45-56 · pattern B
$: note("<a1 f1 g1 e1>").transpose(-4).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf(500).lpq(10).distort(3.5).distortvol(.5)
  .decay(.1).sustain(0).gain(0.55).mask(section7).velocity(section7).orbit(2).analyze("bass")
// Outro · bars 57-60 · pattern B
$: note("<a1 f1 g1 e1>").transpose(-4).struct("[~ x x] [~ x x] [~ x x] [~ x x]")
  .s("sawtooth").lpf("<500 373.33 246.67 120>").lpq(10).distort(3).distortvol(.5)
  .decay(.1).sustain(0).gain("<0.5 0.37 0.23 0.1>").mask(section8).velocity(section8).orbit(2).analyze("bass")

