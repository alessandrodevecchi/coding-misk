// ========== riser ==========
// Build · bars 9-16 · pattern A
// Riser · white noise rising over 8 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(8))
  .gain(saw.slow(8).range(0, .35).late(8)).mask(section2).velocity(section2).orbit(8).analyze("riser")
// Fall · bars 29-30 · pattern A
// Downlifter · noise falling over 2 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(2).range(8000, 300).late(28))
  .gain(saw.slow(2).range(.35, 0).late(28)).mask(section4).velocity(section4).orbit(8).analyze("riser")
// Rebuild · bars 37-44 · pattern A
// Riser · white noise rising over 8 bars
$: s("white*16").decay(.06).sustain(0)
  .hpf(saw.slow(8).range(300, 8000).late(36))
  .gain(saw.slow(8).range(0, .4).late(36)).mask(section6).velocity(section6).orbit(8).analyze("riser")
