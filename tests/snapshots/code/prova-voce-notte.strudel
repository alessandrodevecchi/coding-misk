// coding-misk · Voce nella notte
// song composed with sections and tracks: each track plays its clips, switched on by the section lane (1 plays, 0 is silent, values in between fade)
// each .analyze("…") lights up its instrument in the Stage visual
setcpm(108/4)

const SECTIONS = [['Intro', 8], ['Groove', 16], ['Break', 8], ['Drop', 16], ['Outro', 8]]
const TEMPO = {'Intro': 108, 'Groove': 108, 'Break': 108, 'Drop': 108, 'Outro': 108}

// section lanes: 1 plays, 0 is silent, values in between fade
const section1 = "<1!8 0!48>"  // Intro · 8 bars · 108 BPM · E · Em F Em D
const section2 = "<0!8 1!16 0!32>"  // Groove · 16 bars · 108 BPM · E · Em C D B
const section3 = "<0!24 1!8 0!24>"  // Break · 8 bars · 108 BPM · E · Em F Em D
const section4 = "<0!32 1!16 0!8>"  // Drop · 16 bars · 108 BPM · E · Em C D B
const section5 = "<0!48 1!8>"  // Outro · 8 bars · 108 BPM · E · Em F Em D

// ========== Kick · drums ==========
// Groove · bars 9-24 · pattern A
// Drums · LinnDrum
$: s("bd*4").bank("LinnDrum").gain(0.85).distort(0.6).distortvol(.5).mask(section2).velocity(section2).orbit(1).analyze("kick")
// Drop · bars 33-48 · pattern A
$: s("bd*4").bank("LinnDrum").gain(0.85).distort(0.6).distortvol(.5).mask(section4).velocity(section4).orbit(1).analyze("kick")
$: s("cr").bank("LinnDrum").gain(.55).room(.4).mask("<1 0!15>").mask(section4).velocity(section4).orbit(1).analyze("fx")

// ========== Beat · drums ==========
// Drop · bars 33-48 · pattern A
// Drums · LinnDrum
$: s("[~ sd]*2").bank("LinnDrum").gain(0.45).mask(section4).velocity(section4).orbit(9).analyze("snare")
$: s("[~ hh]*4").bank("LinnDrum").gain(0.3).mask(section4).velocity(section4).orbit(9).analyze("hats")
$: s("cr").bank("LinnDrum").gain(.55).room(.4).mask("<1 0!15>").mask(section4).velocity(section4).orbit(9).analyze("fx")

// ========== Bass · bass ==========
// Groove · bars 9-24 · pattern A
// Bass · Spiral riff (octaves)
$: note("<a1 f1 g1 e1>").transpose(-5).struct("x ~ x x ~ x x ~ x ~ x x ~ x x x").transpose("[0 0 12 0]!3 [0 1 0 -2]")
  .s("square").lpf(sine.range(280, 1120).slow(8)).lpq(8).distort(0.8).distortvol(.5)
  .decay(.12).sustain(.3).gain(0.65).mask(section2).velocity(section2).orbit(2).analyze("bass")
// Drop · bars 33-48 · pattern A
$: note("<a1 f1 g1 e1>").transpose(-5).struct("x ~ x x ~ x x ~ x ~ x x ~ x x x").transpose("[0 0 12 0]!3 [0 1 0 -2]")
  .s("square").lpf(sine.range(280, 1120).slow(8)).lpq(8).distort(0.8).distortvol(.5)
  .decay(.12).sustain(.3).gain(0.65).mask(section4).velocity(section4).orbit(2).analyze("bass")

// ========== Pad · pad ==========
// Intro · bars 1-8 · pattern A
// Pad · Sustained
$: note("<[a2,c3,e3] [a#2,d3,f3] [a2,c3,e3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(480, 1920).slow(8))
  .room(.85).gain(0.25).mask(section1).velocity(section1).orbit(6).analyze("pad")
// Break · bars 25-32 · pattern A
$: note("<[a2,c3,e3] [a#2,d3,f3] [a2,c3,e3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(480, 1920).slow(8))
  .room(.85).gain(0.25).mask(section3).velocity(section3).orbit(6).analyze("pad")
// Outro · bars 49-56 · pattern A
$: note("<[a2,c3,e3] [a#2,d3,f3] [a2,c3,e3] [g2,b2,d3]>").transpose(-5)
  .s("supersaw").attack(.4).release(1.2).lpf(sine.range(480, 1920).slow(8))
  .room(.85).gain(0.25).mask(section5).velocity(section5).orbit(6).analyze("pad")

// ========== Arp · arp ==========
// Drop · bars 33-48 · pattern A
// Arpeggio · Pulsar, 16ths
$: note("<[a3,c4,e4,a4] [f3,a3,c4,f4] [g3,b3,d4,g4] [g#3,b3,e4,g#4]>").arp("[0 3 1 3 2 3 1 3]*2").transpose(-5)
  .s("sawtooth").lpf(sine.range(720, 2880).slow(8)).lpq(4)
  .decay(.15).sustain(.15).delay(.35).gain(0.3).mask(section4).velocity(section4).orbit(3).analyze("arp")

// ========== Words · spoken ==========
// "the towers never sleep" · opening · bar 7
$: s("say_en_reed").n(3).late(0.875).mask("<0!6 1 0!49>").stretch(0.8).lpf(6000).room(0.35).postgain(0.55).orbit(13).analyze("fx")
// "empty streets · awake · city lights" · refrain · bar 25, 29
$: n("2 0 1 ~").s("say_en_reed").mask("<0!24 1 0!3 1 0!27>").stretch(0.8).lpf(6000).room(0.35).postgain(0.55).orbit(13).analyze("fx")
