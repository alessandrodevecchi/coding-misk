{
  "name": "coding-misk",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Synth lab locale per comporre musica con Strudel",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:code": "node --no-warnings tools/snapshot-code.mjs check",
    "snapshot:code": "node --no-warnings tools/snapshot-code.mjs write",
    "check:songs": "node --no-warnings tools/song.mjs validate songs",
    "voices": "node --no-warnings tools/voice.mjs",
    "check:endless": "node --no-warnings tools/check-endless.mjs",
    "endless": "node --no-warnings tools/endless.mjs",
    "check:styles": "node --no-warnings tools/style.mjs validate",
    "check:song-filter": "node --no-warnings tools/check-song-filter.mjs",
    "check:playlists": "node --no-warnings tools/check-playlists.mjs",
    "check:guide": "node --no-warnings tools/check-guide.mjs",
    "check:soul": "node --no-warnings tools/check-soul.mjs",
    "check:random": "node --no-warnings tools/check-random.mjs",
    "check:compilation": "node --no-warnings tools/check-compilation.mjs",
    "check:video": "node --no-warnings tools/check-video.mjs",
    "check:export": "node --no-warnings tools/check-export.mjs",
    "check:live": "node --no-warnings tools/check-live.mjs",
    "check:crescendo": "node --no-warnings tools/check-crescendo.mjs",
    "check:live-code": "node --no-warnings tools/check-live-code.mjs",
    "check:scroll": "node --no-warnings tools/check-visuals-scroll.mjs",
    "check:typing": "node --no-warnings tools/check-typing.mjs",
    "check:profiles": "node --no-warnings tools/check-profiles.mjs",
    "check:clips": "node --no-warnings tools/check-clips.mjs",
    "check:sound-guard": "node --no-warnings tools/check-sound-guard.mjs"
  },
  "dependencies": {
    "@mediabunny/flac-encoder": "^1.61.3",
    "@mediabunny/mp3-encoder": "^1.61.3",
    "@strudel/repl": "1.3.0",
    "mediabunny": "^1.61.3"
  },
  "devDependencies": {
    "vite": "8.3.2"
  }
}
