    "voices": "node --no-warnings tools/voice.mjs",
    "check:endless": "node --no-warnings tools/check-endless.mjs",
    "endless": "node --no-warnings tools/endless.mjs",
    "check:styles": "node --no-warnings tools/style.mjs validate",
    "check:song-filter": "node --no-warnings tools/check-song-filter.mjs",
    "check:playlists": "node --no-warnings tools/check-playlists.mjs",
    "check:trash": "node --no-warnings tools/check-trash.mjs",
    "check:guide": "node --no-warnings tools/check-guide.mjs",
    "check:soul": "node --no-warnings tools/check-soul.mjs",
    "check:random": "node --no-warnings tools/check-random.mjs",
    "check:invent": "node --no-warnings tools/check-invent.mjs",
    "check:compilation": "node --no-warnings tools/check-compilation.mjs",
    "check:radio-profiles": "node --no-warnings tools/check-radio-profiles.mjs",
    "check:video": "node --no-warnings tools/check-video.mjs",
    "check:export": "node --no-warnings tools/check-export.mjs",
    "check:live": "node --no-warnings tools/check-live.mjs",
    "check:crescendo": "node --no-warnings tools/check-crescendo.mjs",
    "check:workers": "node --no-warnings tools/check-pool.mjs --test",
    "check:live-code": "node --no-warnings tools/check-live-code.mjs",
    "check:mixer": "node --no-warnings tools/check-mixer.mjs",
    "check:ramps": "node --no-warnings tools/check-ramps.mjs",
    "check:typing": "node --no-warnings tools/check-typing.mjs",
    "check:profiles": "node --no-warnings tools/check-profiles.mjs",
    "check:clips": "node --no-warnings tools/check-clips.mjs",
    "check:sound-guard": "node --no-warnings tools/check-sound-guard.mjs",
    "catalog:strudel": "node --no-warnings tools/strudel-catalog.mjs",
    "check:strudel": "node --no-warnings tools/check-strudel.mjs",
    "check:ideas": "node --no-warnings tools/check-idea-writer.mjs",
    "check:functions": "node --no-warnings tools/check-functions.mjs",
    "check:material": "node --no-warnings tools/check-material.mjs",
    "check:patterns": "node --no-warnings tools/check-patterns.mjs",
    "check:preview": "node --no-warnings tools/check-preview.mjs",
    "check:fm-lab": "node --no-warnings tools/check-fm-lab.mjs",
    "check:fm-effects": "node --no-warnings tools/check-fm-effects.mjs",
    "check:spoken": "node --no-warnings tools/check-spoken.mjs",
    "knowledge": "node --no-warnings tools/knowledge.mjs",
    "check:knowledge": "node --no-warnings tools/check-knowledge.mjs",
    "durations": "node --no-warnings tools/song-durations.mjs write",
    "check:durations": "node --no-warnings tools/song-durations.mjs check",
    "check:song-options": "node --no-warnings tools/check-song-options.mjs",
    "growth:probe": "node --no-warnings tools/growth-probe.mjs"
