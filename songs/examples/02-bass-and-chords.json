{
  "format": "coding-misk/song",
  "version": 2,
  "id": "example-bass-and-chords",
  "title": "Example 2 · Bass and chords",
  "look": "tramonto",
  "style": { "en": "Two sections, a bass line written as chord tones, a pad that enters later", "it": "Due sezioni, un basso scritto come note dell'accordo, un pad che entra dopo" },
  "tags": { "genres": ["techno"], "free": ["example"] },
  "sections": [
    { "name": "Verse", "bars": 8, "bpm": 110, "key": "E", "chords": "malinconica", "meter": "4/4" },
    { "name": "Chorus", "bars": 8, "bpm": 110, "key": "E", "chords": "epica", "meter": "4/4", "crash": true }
  ],
  "tracks": [
    {
      "id": "drums",
      "type": "drums",
      "settings": { "kit": "RolandTR808", "gain": 0.9 },
      "patterns": {
        "verse": { "rows": { "bd": "x.....x...x.....", "cp": "....x.......x...", "hh": "x.x.x.x.x.x.x.x." } },
        "chorus": { "rows": { "bd": "x...x...x...x...", "cp": "....x.......x...", "hh": "xxxxxxxxxxxxxxxx", "oh": "..x...x...x...x." } }
      },
      "clips": [
        { "section": "Verse", "pattern": "verse" },
        { "section": "Chorus", "pattern": "chorus" }
      ]
    },
    {
      "id": "bass",
      "type": "bass",
      "settings": { "wave": "sawtooth", "gain": 1, "cutoff": 900, "move": "fisso", "reso": 6, "drive": 0.5 },
      "patterns": {
        "walk": { "preset": "sub", "notes": "0 ~ 0 2 ~ 0 3 ~ 0 ~ 0 2 ~ 1 2 ~" }
      },
      "clips": [{ "start": 0, "bars": 16, "pattern": "walk" }]
    },
    {
      "id": "pad",
      "type": "pad",
      "settings": { "wave": "supersaw", "gain": 0.22, "cutoff": 1600, "room": 0.8 },
      "patterns": { "hold": { "preset": "pad" } },
      "clips": [{ "section": "Chorus", "pattern": "hold" }]
    }
  ]
}
